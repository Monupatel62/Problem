# ── WohoTech Judge Worker — Render / Docker-socket-free deployment ────────────
#
# Python3 + GCC + Java + SQLite are installed directly in this image.
# No Docker-in-Docker. Works on Render, Railway, Fly.io, any container host.
# Optimized for Render free tier (512MB RAM limit).

FROM node:20-bookworm-slim

# ── System toolchain (memory-optimized) ──────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    gcc \
    g++ \
    openjdk-17-jdk-headless \
    sqlite3 \
    libsqlite3-dev \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && apt-get clean

# Verify
RUN python3 --version && g++ --version && java -version && javac -version && sqlite3 --version

# ── Install better-sqlite3 for Node SQL runner ────────────────────────────────
WORKDIR /app
COPY docker/judge/package.judge.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund

# ── App ───────────────────────────────────────────────────────────────────────
COPY scripts/problems/judge-worker-direct.mjs ./scripts/problems/judge-worker-direct.mjs

ENV NODE_ENV=production
ENV PORT=8787
# Limit Node.js heap to leave room for Java/C++ compilation (Render free = 512MB)
ENV NODE_OPTIONS="--max-old-space-size=128"
# Java compiler memory limits
ENV JAVA_TOOL_OPTIONS="-Xmx128m -Xms32m"

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "--max-old-space-size=128", "scripts/problems/judge-worker-direct.mjs"]
