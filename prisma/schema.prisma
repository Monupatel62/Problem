  tasks     WPWorkspaceTask[]

  @@index([workspaceId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("wp_workspace_projects")
}

model WPWorkspaceTask {
  id          String         @id @default(dbgenerated("gen_random_uuid()::text"))
  projectId   String
  workspaceId String
  assigneeId  String?
  title       String
  description String?
  status      WPTaskStatus   @default(TODO)
  priority    WPTaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  metadata    Json?          @default("{}")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project   WPWorkspaceProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace WPBusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User?               @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([workspaceId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("wp_workspace_tasks")
}

model WPBusinessAuditLog {
  id          String                @id @default(dbgenerated("gen_random_uuid()::text"))
  workspaceId String
  userId      String
  action      WPBusinessAuditAction
  targetId    String?
  targetType  String?
  details     Json?                 @default("{}")
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime              @default(now())

  workspace WPBusinessWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User                @relation("UserBusinessAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("wp_business_audit_logs")
}

// ============================================================
// Phase 19: Enterprise Social Infrastructure & Global Collaboration
// ============================================================

enum WPEnterpriseType {
  COMPANY
  UNIVERSITY
  GOVERNMENT
  NGO
  STARTUP
  AGENCY
  HEALTHCARE
  MEDIA
}

enum WPEnterpriseSize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum WPEnterpriseAccountStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum WPEnterpriseWorkspaceType {
  PRIVATE
  PUBLIC
  HYBRID
}

enum WPEnterpriseRoleType {
  OWNER
  ADMINISTRATOR
  MANAGER
  DEPARTMENT_HEAD
  MODERATOR
  EMPLOYEE
  GUEST
}

enum WPEnterpriseDocType {
  DOCUMENT
  POLICY
  TRAINING
  WIKI
  KNOWLEDGE_BASE
}

enum WPEnterpriseProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum WPEnterpriseCommType {
  ANNOUNCEMENT
  FEED_POST
  KNOWLEDGE_POST
  MESSAGE
  BROADCAST
}

enum WPEnterpriseAutomationType {
  APPROVAL
  NOTIFICATION
  TASK
  HR_WORKFLOW
  KNOWLEDGE_UPDATE
}

enum WPEnterpriseComplianceStatus {
  COMPLIANT
  NON_COMPLIANT
  UNDER_REVIEW
  EXEMPT
}

enum WPEnterpriseAuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  PERMISSION_CHANGE
  SETTINGS_CHANGE
  SECURITY_EVENT
}

model WPEnterpriseAccount {
  id             String                      @id @default(dbgenerated("gen_random_uuid()::text"))
  name           String
  slug           String                      @unique
  type           WPEnterpriseType            @default(COMPANY)
  ownerId        String
  logoUrl        String?
  domain         String?
  industry       String?
  size           WPEnterpriseSize            @default(SMALL)
  status         WPEnterpriseAccountStatus   @default(ACTIVE)
  settings       Json?                       @default("{}")
  customBranding Json?                       @default("{}")
  ssoEnabled     Boolean                     @default(false)
  mfaRequired    Boolean                     @default(false)
  employeeCount  Int                         @default(0)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  owner          User                        @relation("UserEnterpriseAccounts", fields: [ownerId], references: [id], onDelete: Cascade)
  organizations  WPEnterpriseOrganization[]
  departments    WPEnterpriseDepartment[]
  teams          WPEnterpriseTeam[]
  workspaces     WPEnterpriseWorkspaceV2[]
  roles          WPEnterpriseRoleAssignment[]
  knowledge      WPEnterpriseKnowledge[]
  projects       WPEnterpriseProjectV2[]
  communications WPEnterpriseCommunication[]
  analytics      WPEnterpriseAnalyticsV2[]
  automationRules WPEnterpriseAutomationRule[]
  compliance     WPEnterpriseCompliance[]
  auditRecords   WPEnterpriseAuditRecord[]
  adminLogs      WPEnterpriseAdminLog[]

  @@index([ownerId])
  @@index([type])
  @@index([status])
  @@index([domain])
  @@map("wp_enterprise_accounts")
}

model WPEnterpriseOrganization {
  id          String                      @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId   String
  name        String
  description String?
  parentId    String?
  level       Int                         @default(0)
  metadata    Json?                       @default("{}")
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  account     WPEnterpriseAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parent      WPEnterpriseOrganization?   @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    WPEnterpriseOrganization[]  @relation("OrgHierarchy")
  departments WPEnterpriseDepartment[]

  @@index([accountId])
  @@index([parentId])
  @@index([level])
  @@map("wp_enterprise_organizations")
}

model WPEnterpriseDepartment {
  id             String                     @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId      String
  organizationId String
  name           String
  headId         String?
  description    String?
  employeeCount  Int                        @default(0)
  budget         Float?                     @default(0)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  account        WPEnterpriseAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization   WPEnterpriseOrganization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  head           User?                      @relation("EnterpriseDeptHead", fields: [headId], references: [id], onDelete: SetNull)
  teams          WPEnterpriseTeam[]

  @@index([accountId])
  @@index([organizationId])
  @@index([headId])
  @@map("wp_enterprise_departments")
}

model WPEnterpriseTeam {
  id           String                    @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId    String
  departmentId String
  name         String
  leadId       String?
  description  String?
  memberCount  Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  account      WPEnterpriseAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  department   WPEnterpriseDepartment    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lead         User?                     @relation("EnterpriseTeamLead", fields: [leadId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([departmentId])
  @@index([leadId])
  @@map("wp_enterprise_teams")
}

model WPEnterpriseWorkspaceV2 {
  id          String                      @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId   String
  name        String
  type        WPEnterpriseWorkspaceType   @default(PRIVATE)
  description String?
  isDefault   Boolean                     @default(false)
  branding    Json?                       @default("{}")
  settings    Json?                       @default("{}")
  memberCount Int                         @default(0)
  isArchived  Boolean                     @default(false)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  account     WPEnterpriseAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([type])
  @@index([isDefault])
  @@map("wp_enterprise_workspaces")
}

model WPEnterpriseRoleAssignment {
  id           String                   @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId    String
  userId       String
  role         WPEnterpriseRoleType     @default(EMPLOYEE)
  departmentId String?
  teamId       String?
  permissions  Json?                    @default("{}")
  isActive     Boolean                  @default(true)
  assignedAt   DateTime                 @default(now())
  expiresAt    DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  account      WPEnterpriseAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user         User                     @relation("UserEnterpriseRoles", fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([userId])
  @@index([role])
  @@index([accountId, userId])
  @@index([isActive])
  @@map("wp_enterprise_roles")
}

model WPEnterpriseKnowledge {
  id           String                 @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId    String
  authorId     String
  title        String
  content      String?
  type         WPEnterpriseDocType    @default(DOCUMENT)
  category     String?
  tags         String[]               @default([])
  version      Int                    @default(1)
  isPublished  Boolean                @default(false)
  viewCount    Int                    @default(0)
  lastEditedBy String?
  metadata     Json?                  @default("{}")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  account      WPEnterpriseAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  author       User                   @relation("UserEnterpriseKnowledge", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([authorId])
  @@index([type])
  @@index([category])
  @@index([isPublished])
  @@map("wp_enterprise_knowledge")
}

model WPEnterpriseProjectV2 {
  id             String                       @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId      String
  name           String
  description    String?
  status         WPEnterpriseProjectStatus    @default(PLANNING)
  ownerId        String
  teamId         String?
  startDate      DateTime?
  endDate        DateTime?
  progress       Float                        @default(0)
  milestones     Json?                        @default("[]")
  taskCount      Int                          @default(0)
  completedTasks Int                          @default(0)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  account        WPEnterpriseAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner          User                         @relation("UserEnterpriseProjects", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([ownerId])
  @@index([status])
  @@index([teamId])
  @@map("wp_enterprise_projects_v2")
}

model WPEnterpriseCommunication {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId          String
  authorId           String
  type               WPEnterpriseCommType    @default(FEED_POST)
  title              String?
  content            String
  targetDepartmentId String?
  targetTeamId       String?
  isPinned           Boolean                 @default(false)
  isUrgent           Boolean                 @default(false)
  readCount          Int                     @default(0)
  metadata           Json?                   @default("{}")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  account            WPEnterpriseAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  author             User                    @relation("UserEnterpriseCommunications", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([authorId])
  @@index([type])
  @@index([isPinned])
  @@index([isUrgent])
  @@map("wp_enterprise_communications")
}

model WPEnterpriseAnalyticsV2 {
  id           String                 @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId    String
  metricType   String
  metricName   String
  value        Float                  @default(0)
  dimensions   Json?                  @default("{}")
  period       String?
  departmentId String?
  teamId       String?
  userId       String?
  createdAt    DateTime               @default(now())

  account      WPEnterpriseAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([metricType])
  @@index([period])
  @@index([userId])
  @@map("wp_enterprise_analytics_v2")
}

model WPEnterpriseAutomationRule {
  id             String                        @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId      String
  name           String
  type           WPEnterpriseAutomationType    @default(NOTIFICATION)
  trigger        Json                          @default("{}")
  conditions     Json?                         @default("{}")
  actions        Json                          @default("[]")
  isActive       Boolean                       @default(true)
  executionCount Int                           @default(0)
  lastExecutedAt DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  account        WPEnterpriseAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([type])
  @@index([isActive])
  @@map("wp_enterprise_automation_rules")
}

model WPEnterpriseCompliance {
  id              String                          @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId       String
  category        String
  status          WPEnterpriseComplianceStatus    @default(UNDER_REVIEW)
  description     String?
  evidence        Json?                           @default("[]")
  reviewedBy      String?
  reviewedAt      DateTime?
  nextReviewDate  DateTime?
  retentionPolicy Json?                           @default("{}")
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  account         WPEnterpriseAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status])
  @@index([category])
  @@index([nextReviewDate])
  @@map("wp_enterprise_compliance")
}

model WPEnterpriseAuditRecord {
  id           String                    @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId    String
  userId       String
  action       WPEnterpriseAuditAction
  resourceType String
  resourceId   String?
  details      Json?                     @default("{}")
  ipAddress    String?
  timestamp    DateTime                  @default(now())
  createdAt    DateTime                  @default(now())

  account      WPEnterpriseAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user         User                      @relation("UserEnterpriseAudit", fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([resourceType])
  @@map("wp_enterprise_audit_records")
}

model WPEnterpriseAdminLog {
  id            String                  @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId     String
  adminId       String
  action        String
  targetType    String?
  targetId      String?
  previousValue Json?
  newValue      Json?
  reason        String?
  ipAddress     String?
  createdAt     DateTime                @default(now())

  account       WPEnterpriseAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  admin         User                    @relation("UserEnterpriseAdminLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("wp_enterprise_admin_logs")
}
