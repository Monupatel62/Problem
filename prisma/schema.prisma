model WPCallSession {
  id             String         @id @default(cuid())
  conversationId String
  conversation   WPConversation @relation(fields: [conversationId], references: [id])
  initiatorId    String
  callType       WPCallType
  status         WPCallStatus   @default(RINGING_CS)
  participants   String[]       @default([])
  startedAt      DateTime?
  endedAt        DateTime?
  durationSec    Int            @default(0)
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@map("wp_call_sessions")
}

