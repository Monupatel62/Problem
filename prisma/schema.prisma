// ─── Reel Audio ─────────────────────────────────────────────────────────────────
model WPReelAudio {
  id         String          @id @default(dbgenerated("gen_random_uuid()::text"))
  title      String
  artistName String?
  audioUrl   String
  duration   Int             @default(0)
  coverUrl   String?
  usageCount Int             @default(0)
  type       WPReelAudioType @default(ORIGINAL)
  isOriginal Boolean         @default(true)
  isTrending Boolean         @default(false)
  genre      String?
  mood       String?
  creatorId  String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  creator User     @relation("UserReelAudio", fields: [creatorId], references: [id], onDelete: Cascade)
  reels   WPReel[] @relation("ReelAudio")

  @@index([creatorId])
  @@index([isTrending])
  @@index([usageCount(sort: Desc)])
  @@index([title])
  @@index([createdAt(sort: Desc)])
  @@map("wp_reel_audio")
}

// ─── Reel ───────────────────────────────────────────────────────────────────────
model WPReel {
  id             String         @id @default(dbgenerated("gen_random_uuid()::text"))
  title          String?
  description    String?
  videoUrl       String?
  thumbnailUrl   String?
  duration       Int            @default(0)
  maxDuration    WPReelDuration @default(SEC_60)
  audioId        String?
  effectIds      String[]       @default([])
  hashtags       String[]       @default([])
  mentions       String[]       @default([])
  category       String?
  status         WPReelStatus   @default(DRAFT)
  viewCount      Int            @default(0)
  likeCount      Int            @default(0)
  commentCount   Int            @default(0)
  shareCount     Int            @default(0)
  saveCount      Int            @default(0)
  remixCount     Int            @default(0)
  completionRate Float          @default(0)
  watchTime      Int            @default(0)
  viralScore     Float          @default(0)
  isSponsored    Boolean        @default(false)
  allowRemix     Boolean        @default(true)
  allowComments  Boolean        @default(true)
  allowDuet      Boolean        @default(true)
  creatorId      String
  publishedAt    DateTime?
  scheduledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  creator         User                  @relation("UserReels", fields: [creatorId], references: [id], onDelete: Cascade)
  audio           WPReelAudio?          @relation("ReelAudio", fields: [audioId], references: [id], onDelete: SetNull)
  analytics       WPReelAnalytics[]     @relation("ReelAnalytics")
  recommendations WPReelRecommendation[] @relation("ReelRecommendations")
  engagements     WPReelEngagement[]    @relation("ReelEngagements")
  originalRemixes WPReelRemix[]         @relation("OriginalReelRemixes")
  remixedFrom     WPReelRemix[]         @relation("RemixedReelRemixes")
  reports         WPReelReport[]        @relation("ReelReports")

  @@index([creatorId])
  @@index([status])
  @@index([audioId])
  @@index([category])
  @@index([viralScore(sort: Desc)])
  @@index([viewCount(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("wp_reels")
}

// ─── Reel Effect ────────────────────────────────────────────────────────────────
model WPReelEffect {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  name        String
  description String?
  type        String   @default("FILTER")
  previewUrl  String?
  iconUrl     String?
  parameters  Json?    @default("{}")
  usageCount  Int      @default(0)
  isTrending  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([isTrending])
  @@index([usageCount(sort: Desc)])
  @@map("wp_reel_effects")
}

// ─── Reel Category ──────────────────────────────────────────────────────────────
model WPReelCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  name        String
  slug        String   @unique
  description String?
  iconUrl     String?
  coverUrl    String?
  reelCount   Int      @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("wp_reel_categories")
}

// ─── Reel Analytics ─────────────────────────────────────────────────────────────
model WPReelAnalytics {
  id                   String   @id @default(dbgenerated("gen_random_uuid()::text"))
  reelId               String
  date                 DateTime @default(now())
  views                Int      @default(0)
  reach                Int      @default(0)
  impressions          Int      @default(0)
  watchTime            Int      @default(0)
  avgWatchTime         Float    @default(0)
  completionRate       Float    @default(0)
  likes                Int      @default(0)
  comments             Int      @default(0)
  shares               Int      @default(0)
  saves                Int      @default(0)
  remixes              Int      @default(0)
  followerGained       Int      @default(0)
  viralScore           Float    @default(0)
  audienceDemographics Json?    @default("{}")
  trafficSources       Json?    @default("{}")
  createdAt            DateTime @default(now())

  reel WPReel @relation("ReelAnalytics", fields: [reelId], references: [id], onDelete: Cascade)

  @@index([reelId])
  @@index([date(sort: Desc)])
  @@index([reelId, date])
  @@map("wp_reel_analytics")
}

// ─── Reel Recommendation ────────────────────────────────────────────────────────
model WPReelRecommendation {
  id           String    @id @default(dbgenerated("gen_random_uuid()::text"))
  userId       String
  reelId       String
  score        Float     @default(0)
  reason       String?
  algorithm    String    @default("collaborative")
  isViewed     Boolean   @default(false)
  isInteracted Boolean   @default(false)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  user User   @relation("UserReelRecommendations", fields: [userId], references: [id], onDelete: Cascade)
  reel WPReel @relation("ReelRecommendations", fields: [reelId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reelId])
  @@index([score(sort: Desc)])
  @@index([userId, score(sort: Desc)])
  @@map("wp_reel_recommendations")
}

// ─── Reel Engagement ────────────────────────────────────────────────────────────
model WPReelEngagement {
  id        String               @id @default(dbgenerated("gen_random_uuid()::text"))
  reelId    String
  userId    String
  type      WPReelEngagementType
  content   String?
  metadata  Json?                @default("{}")
  createdAt DateTime             @default(now())

  reel WPReel @relation("ReelEngagements", fields: [reelId], references: [id], onDelete: Cascade)
  user User   @relation("UserReelEngagements", fields: [userId], references: [id], onDelete: Cascade)

  @@index([reelId])
  @@index([userId])
  @@index([type])
  @@index([reelId, type])
  @@index([userId, type])
  @@index([createdAt(sort: Desc)])
  @@map("wp_reel_engagements")
}

// ─── Reel Remix ─────────────────────────────────────────────────────────────────
model WPReelRemix {
  id             String          @id @default(dbgenerated("gen_random_uuid()::text"))
  originalReelId String
  remixReelId    String
  remixType      WPReelRemixType @default(SIDE_BY_SIDE)
  creatorId      String
  createdAt      DateTime        @default(now())

  originalReel WPReel @relation("OriginalReelRemixes", fields: [originalReelId], references: [id], onDelete: Cascade)
  remixReel    WPReel @relation("RemixedReelRemixes", fields: [remixReelId], references: [id], onDelete: Cascade)
  creator      User   @relation("UserReelRemixes", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([originalReelId])
  @@index([remixReelId])
  @@index([creatorId])
  @@index([createdAt(sort: Desc)])
  @@map("wp_reel_remixes")
}

// ─── Reel Report ────────────────────────────────────────────────────────────────
model WPReelReport {
  id          String             @id @default(dbgenerated("gen_random_uuid()::text"))
  reelId      String
  reporterId  String
  reason      WPReelReportReason
  description String?
  status      String             @default("PENDING")
  resolution  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())

  reel     WPReel @relation("ReelReports", fields: [reelId], references: [id], onDelete: Cascade)
