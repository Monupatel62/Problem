  lastReadAt     DateTime?
  unreadCount    Int               @default(0)
  joinedAt       DateTime          @default(now())
  leftAt         DateTime?

  @@unique([conversationId, userId])
  @@index([userId, isActive])
  @@index([conversationId, isActive])
  @@map("wp_participants")
}

model WPMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   WPConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  messageType    WPMessageType  @default(TEXT_MSG)
  content        String?
  replyToId      String?
  forwardedFrom  String?
  mentions       String[]       @default([])
  isEdited       Boolean        @default(false)
  isDeleted      Boolean        @default(false)
  isPinned       Boolean        @default(false)
  readBy         String[]       @default([])
  deliveredTo    String[]       @default([])
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  reactions   WPMessageReaction[]
  attachments WPAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("wp_messages")
}

model WPMessageReaction {
  id           String            @id @default(cuid())
  messageId    String
  message      WPMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId       String
  reactionType WPMsgReactionType
  createdAt    DateTime          @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("wp_message_reactions")
}

model WPAttachment {
  id           String    @id @default(cuid())
  messageId    String
  message      WPMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileUrl      String
  fileName     String?
  fileType     String?
  fileSize     Int       @default(0)
  thumbnailUrl String?
  width        Int?
  height       Int?
  duration     Int?
  createdAt    DateTime  @default(now())

  @@index([messageId])
  @@map("wp_attachments")
}

model WPPresence {
  id        String           @id @default(cuid())
  userId    String           @unique
  status    WPPresenceStatus @default(OFFLINE_PR)
  lastSeen  DateTime         @default(now())
  device    String?
  isTyping  Boolean          @default(false)
  typingIn  String?
  updatedAt DateTime         @updatedAt

  @@index([status])
  @@map("wp_presence")
}

// ── Message Requests (private messaging) ──────────────────────────────────────
