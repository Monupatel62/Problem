generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}


datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  USER    @map("STUDENT")
  CREATOR @map("TEACHER")
}

enum VideoType {
  REEL
  LECTURE
  SHORT
  LIVE_RECORDING
  POST
}

enum VideoVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum ModerationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  UNPUBLISHED
}

enum CourseLevel {
  SCHOOL
  UG
  PG
  DIPLOMA
  DOCTORAL
  CERTIFICATION
}

enum GoverningBody {
  UGC
  AICTE
  NCVT
  NCTE
  PCI
  NMC
  BCI
  ICAR
  COA
  NONE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  REEL
  POST
  VIDEO
  NOTE
  LIVE
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemTrack {
  ALGORITHMS
  DATABASE
  SHELL
  CONCURRENCY
}

enum ProblemCaseKind {
  SAMPLE
  HIDDEN
}

enum ProblemSubmissionStatus {
  ACCEPTED
  WRONG_ANSWER
  RUNTIME_ERROR
  COMPILATION_ERROR
  TIME_LIMIT_EXCEEDED
  INTERNAL_ERROR
}

enum CreatorType {
  INDIVIDUAL_CREATOR
  PROFESSIONAL_CREATOR
  INFLUENCER
  PUBLIC_FIGURE
  ARTIST
  MUSICIAN
  GAMER
  STREAMER
  BUSINESS
  BRAND
  ORGANIZATION
  EDUCATIONAL_CREATOR
  NEWS_CREATOR
  CELEBRITY
}

enum VerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AdminActionType {
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  CREATOR_SUSPENDED
  CREATOR_REACTIVATED
  CONTENT_REMOVED
  TAG_CREATED
  TAG_DELETED
  CATEGORY_CREATED
  CATEGORY_DELETED
}

// ── User ──────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String    @unique
  password            String?
  emailVerifiedAt     DateTime?
  role                UserRole  @default(USER)
  interests           String[]  @default([])
  preferences         Json? // Store settings as JSON blob
  orgCode             String?
  rollNumber          String?
  isActive            Boolean   @default(true)
  onboardingCompleted Boolean   @default(false)
  isOnline            Boolean   @default(false)
  lastActiveAt        DateTime?

  // Creator profile fields
  username       String?   @unique
  bio            String?
  avatarUrl      String?
  coverUrl       String?
  website        String?
  socialLinks    Json? // { instagram, youtube, twitter, linkedin }
  isVerified     Boolean   @default(false)
  isCreator      Boolean   @default(false)
  creatorSince   DateTime?
  followersCount Int       @default(0)
  followingCount Int       @default(0)
  totalViews     Int       @default(0)

  // Creator identity fields (Phase 1)
  creatorType             CreatorType?       @default(INDIVIDUAL_CREATOR)
  verificationStatus      VerificationStatus @default(NONE)
  verificationDocumentUrl String?
  verificationSubmittedAt DateTime?
  verificationReviewedAt  DateTime?
  verificationReviewNote  String?
  featuredReelIds         String[]           @default([])
  featuredVideoIds        String[]           @default([])
  featuredPostIds         String[]           @default([])
  pinnedAnnouncement      String?
  discoveryTags           String[]           @default([])
  onboardingStep          Int                @default(0) // 0=not started, 1-8=steps, 9=complete
  goals                   Json? // [{ id, title, completed }]

  // Payment wallet for platform credits
  walletBalance Float @default(0) // in INR
  credits       Int   @default(50) // AI assistant query credits (50 free on signup)
  apiCalls      Int   @default(0) // API call quota

  // Plan & Billing (v2 — daily-limit model)
  planType      String    @default("free") // "free" | "starter" | "basic" | "pro" | "elite" | "enterprise"
  billingCycle  String    @default("none") // "none" | "monthly" | "yearly"
  planExpiresAt DateTime? // null = free forever
  planStartedAt DateTime?

  // Daily Usage Tracking
  dailyQueryCount Int      @default(0) // Reset at midnight IST
  dailyImageCount Int      @default(0)
  dailyResetAt    DateTime @default(now()) // When counts were last reset

  // Wallet (top-up bonus credits — don't expire daily)
  walletQueries   Int       @default(0) // Bonus queries from packs
  walletImages    Int       @default(0) // Bonus image credits
  walletSearches  Int       @default(0) // Bonus web searches
  walletExpiresAt DateTime? // When wallet credits expire

  // Geo & Currency
  isInternational Boolean @default(false)
  currency        String  @default("INR") // "INR" | "USD"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  passwordResetToken PasswordResetToken?
  videos             Video[]             @relation("VideoUploads")
  videoComments      VideoComment[]      @relation("VideoComments")
  liveSessions       LiveSession[]       @relation("LiveSessions")
  posts              Post[]              @relation("UserPosts")
  reels              Reel[]              @relation("UserReels")
  likes              ContentLike[]       @relation("UserLikes")
  savedContent       SavedContent[]
  followers          Follow[]            @relation("Following")
  following          Follow[]            @relation("Followers")
  notifications      Notification[]      @relation("UserNotifications")
  problemStatuses    UserProblemStatus[]
  problemSubmissions ProblemSubmission[]
  reports            Report[]            @relation("ReportReporter")
  courseEnrollments  CourseEnrollment[]
  transactions       Transaction[]
  walletTransactions WalletTransaction[]
  watchHistory       WatchHistory[]
  assistantSessions  AssistantSession[]

  // Phase 1 Creator Relations
  verifications          CreatorVerification[]
  creatorGoalEntries     CreatorGoal[]
  creatorInterestEntries CreatorInterest[]
  analyticsEvents        CreatorAnalyticsEvent[]
  adminActionsPerformed  AdminAction[]           @relation("AdminActions")

  // WoHoPlay Phase 6: Pages & Public Profiles
  wpPages         WPPage[]
  wpPageRoles     WPPageRole[]
  wpPageFollowing WPPageFollower[]
  wpPageContent   WPPageContent[]
  wpPageReviews   WPPageReview[]
  wpPageMessages  WPPageMessage[]

  // Phase 7: Groups & Communities relations
  wpOwnedGroups        WPGroup[]             @relation("UserOwnedGroups")
  wpGroupMemberships   WPGroupMember[]       @relation("UserGroupMemberships")
  wpGroupPosts         WPGroupPost[]         @relation("UserGroupPosts")
  wpGroupRules         WPGroupRule[]         @relation("UserGroupRules")
  wpGroupAnnouncements WPGroupAnnouncement[] @relation("UserGroupAnnouncements")
  wpGroupBadges        WPCommunityBadge[]    @relation("UserGroupBadges")
  wpGroupEvents        WPGroupEvent[]        @relation("UserGroupEvents")
  wpGroupChannels      WPGroupChannel[]      @relation("UserGroupChannels")
  wpGroupAuditLogs     WPGroupAuditLog[]     @relation("UserGroupAuditLogs")
  // Phase 8: Events Platform relations
  wpEvents             WPEvent[]             @relation("UserEvents")
  wpEventRSVPs         WPEventRSVP[]         @relation("UserEventRSVPs")
  wpEventInvitesSent   WPEventInvite[]       @relation("UserEventInvitesSent")
  wpEventInvitesReceived WPEventInvite[]     @relation("UserEventInvitesReceived")
  wpEventDiscussions   WPEventDiscussion[]   @relation("UserEventDiscussions")
  wpEventTickets       WPEventTicket[]       @relation("UserEventTickets")
  wpEventCheckins      WPEventCheckin[]      @relation("UserEventCheckins")
  wpEventNotifications WPEventNotification[] @relation("UserEventNotifications")
  wpEventAuditLogs     WPEventAuditLog[]     @relation("UserEventAuditLogs")
  // Phase 9: Marketplace & Social Commerce relations
  wpMarketplaceListings  WPMarketplaceListing[]    @relation("UserMarketplaceListings")
  wpSellerProfile        WPSellerProfile?           @relation("UserSellerProfile")
  wpMarketplaceOrders    WPMarketplaceOrder[]      @relation("UserMarketplaceOrders")
  wpMarketplaceReviews   WPMarketplaceReview[]     @relation("UserMarketplaceReviews")
  wpSavedListings        WPSavedListing[]          @relation("UserSavedListings")
  wpMarketplaceMessages  WPMarketplaceMessage[]    @relation("UserMarketplaceMessages")
  wpMarketplaceAuditLogs WPMarketplaceAuditLog[]   @relation("UserMarketplaceAuditLogs")
  // Phase 10: Watch Video Platform relations
  wpVideos               WPVideo[]               @relation("UserVideos")
  wpVideoChannels        WPVideoChannel[]        @relation("UserVideoChannels")
  wpVideoPlaylists       WPVideoPlaylist[]       @relation("UserVideoPlaylists")
  wpVideoSubscriptions   WPVideoSubscription[]   @relation("UserVideoSubscriptions")
  wpWatchHistory         WPWatchHistory[]        @relation("UserWatchHistory")
  wpVideoReports         WPVideoReport[]         @relation("UserVideoReports")
  wpVideoAuditLogs       WPVideoAuditLog[]       @relation("UserVideoAuditLogs")

  // Phase 11: Reels Platform relations
  wpReels                WPReel[]                @relation("UserReels")
  wpReelEngagements      WPReelEngagement[]      @relation("UserReelEngagements")
  wpReelRemixes          WPReelRemix[]           @relation("UserReelRemixes")
  wpReelAudio            WPReelAudio[]           @relation("UserReelAudio")
  wpReelRecommendations  WPReelRecommendation[]  @relation("UserReelRecommendations")
  wpReelReports          WPReelReport[]          @relation("UserReelReports")
  wpReelAuditLogs        WPReelAuditLog[]        @relation("UserReelAuditLogs")

  // Phase 12: Stories Platform relations
  wpStories              WPStory[]               @relation("UserStories")
  wpStoryViewers         WPStoryViewer[]         @relation("UserStoryViewers")
  wpStoryReactions       WPStoryReaction[]       @relation("UserStoryReactions")
  wpStoryReplies         WPStoryReply[]          @relation("UserStoryReplies")
  wpStoryHighlights      WPStoryHighlight[]      @relation("UserStoryHighlights")
  wpStoryArchives        WPStoryArchive[]        @relation("UserStoryArchives")
  wpStoryAnalytics       WPStoryAnalytics[]      @relation("UserStoryAnalytics")
  wpStoryReports         WPStoryReport[]         @relation("UserStoryReports")
  wpStoryAuditLogs       WPStoryAuditLog[]       @relation("UserStoryAuditLogs")

  // Phase 13: Live Streaming Platform relations
  wpLiveStreams          WPLiveStream[]          @relation("UserLiveStreams")
  wpLiveViewers          WPLiveViewer[]          @relation("UserLiveViewers")
  wpLiveChatMessages     WPLiveChatMessage[]     @relation("UserLiveChatMessages")
  wpLiveReactions        WPLiveReaction[]        @relation("UserLiveReactions")
  wpLiveGifts            WPLiveGift[]            @relation("UserLiveGifts")
  wpLiveGuests           WPLiveGuest[]           @relation("UserLiveGuests")
  wpLiveAuditLogs        WPLiveAuditLog[]        @relation("UserLiveAuditLogs")

  // Phase 14: Search, Discovery & Recommendation relations
  wpSearchHistory        WPSearchHistory[]        @relation("UserSearchHistory")
  wpRecommendations      WPRecommendationEntry[] @relation("UserRecommendations")
  wpUserInterestProfile  WPUserInterestProfile?  @relation("UserInterestProfile")
  wpSearchReports        WPSearchReport[]         @relation("UserSearchReports")
  wpSearchAuditLogs      WPSearchAuditLog[]       @relation("UserSearchAuditLogs")

  // Phase 15: Ads Ecosystem & Advertising Platform relations
  wpAdAccounts           WPAdAccount[]            @relation("UserAdAccounts")
  wpAdCampaigns          WPAdCampaign[]           @relation("UserAdCampaigns")
  wpAdBilling            WPAdBilling[]            @relation("UserAdBilling")
  wpAdAuditLogs          WPAdAuditLog[]           @relation("UserAdAuditLogs")
  // Phase 16: Creator Monetization
  wpCreatorWallet        WPCreatorWallet?         @relation("UserCreatorWallet")
  wpRevenueAnalytics     WPRevenueAnalytics[]     @relation("UserRevenueAnalytics")
  wpCreatorEligibility   WPCreatorEligibility?    @relation("UserCreatorEligibility")
  wpCreatorPayouts       WPCreatorPayout[]        @relation("UserCreatorPayouts")
  wpCreatorSubscriptions WPCreatorSubscription[]  @relation("UserCreatorSubscriptions")
  wpSubscribedTo         WPCreatorSubscription[]  @relation("UserSubscribedTo")
  wpCreatorGiftsSent     WPCreatorGift[]          @relation("UserCreatorGiftsSent")
  wpCreatorGiftsReceived WPCreatorGift[]          @relation("UserCreatorGiftsReceived")
  wpCreatorTipsSent      WPCreatorTip[]           @relation("UserCreatorTipsSent")
  wpCreatorTipsReceived  WPCreatorTip[]           @relation("UserCreatorTipsReceived")
  wpCreatorAffiliates    WPCreatorAffiliate[]     @relation("UserCreatorAffiliates")
  wpMonetizationAuditLogs WPMonetizationAuditLog[] @relation("UserMonetizationAuditLogs")

  // Phase 17: AI Features & Intelligent Platform
  wpAIRequests           WPAIRequest[]            @relation("UserAIRequests")
  wpAIConversations      WPAIConversation[]       @relation("UserAIConversations")
  wpAIUsage              WPAIUsage[]              @relation("UserAIUsage")
  wpAIRecommendations    WPAIRecommendation[]     @relation("UserAIRecommendations")
  wpAIModerationLogs     WPAIModerationLog[]
  wpAIAuditLogs          WPAIAuditLog[]

  // Phase 18: Business & Creator Tools Integration
  wpBusinessWorkspaces    WPBusinessWorkspace[]    @relation("UserBusinessWorkspaces")
  wpCreatorWorkspace      WPCreatorWorkspace?      @relation("UserCreatorWorkspace")
  wpWorkspaceMemberships  WPWorkspaceMember[]      @relation("UserWorkspaceMemberships")
  wpDeveloperApps         WPDeveloperApplication[] @relation("UserDeveloperApps")
  wpAPIKeys               WPAPIKey[]               @relation("UserAPIKeys")
  wpBusinessAuditLogs     WPBusinessAuditLog[]     @relation("UserBusinessAuditLogs")
  wpUnifiedDashboards     WPUnifiedDashboard[]
  wpWorkspaceTasks        WPWorkspaceTask[]

  // Phase 19: Enterprise Social Infrastructure
  wpEnterpriseAccounts       WPEnterpriseAccount[]       @relation("UserEnterpriseAccounts")
  wpEnterpriseRoles          WPEnterpriseRoleAssignment[] @relation("UserEnterpriseRoles")
  wpEnterpriseKnowledge      WPEnterpriseKnowledge[]     @relation("UserEnterpriseKnowledge")
  wpEnterpriseProjects       WPEnterpriseProjectV2[]     @relation("UserEnterpriseProjects")
  wpEnterpriseCommunications WPEnterpriseCommunication[] @relation("UserEnterpriseCommunications")
  wpEnterpriseAuditRecords   WPEnterpriseAuditRecord[]   @relation("UserEnterpriseAudit")
  wpEnterpriseAdminLogs      WPEnterpriseAdminLog[]      @relation("UserEnterpriseAdminLogs")
  wpEnterpriseDeptHead       WPEnterpriseDepartment[]    @relation("EnterpriseDeptHead")
  wpEnterpriseTeamLead       WPEnterpriseTeam[]          @relation("EnterpriseTeamLead")

  // WoHoPlay Posts
  wpPosts                    WPPost[]                    @relation("WPPostAuthor")

  @@map("users")
}

model Report {
  id             String           @id @default(cuid())
  reporterId     String?
  reporter       User?            @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  contentType    ContentType
  contentId      String
  reason         String
  details        String?
  status         ModerationStatus @default(PENDING_REVIEW)
  resolutionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  resolvedAt     DateTime?

  @@index([contentType, contentId])
  @@index([status, createdAt])
  @@map("reports")
}

model Problem {
  id                 String            @id @default(cuid())
  number             Int               @unique
  slug               String            @unique
  title              String
  acceptance         Float             @default(0)
  difficulty         ProblemDifficulty
  track              ProblemTrack      @default(ALGORITHMS)
  tags               String[]
  companies          String[]
  frequency          Int               @default(0)
  premium            Boolean           @default(false)
  likes              Int               @default(0)
  dislikes           Int               @default(0)
  discussionCount    Int               @default(0)
  description        String
  constraints        String[]
  hints              String[]
  functionName       String
  starterCode        Json
  editorial          String[]
  solutionApproaches Json?
  isPublished        Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  examples    ProblemExample[]
  testCases   ProblemTestCase[]
  statuses    UserProblemStatus[]
  submissions ProblemSubmission[]

  @@index([difficulty])
  @@index([track])
  @@index([isPublished])
  @@map("problems")
}

model ProblemExample {
  id          String  @id @default(cuid())
  problemId   String
  problem     Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input       String
  output      String
  explanation String?
  sortOrder   Int     @default(0)

  @@index([problemId])
  @@map("problem_examples")
}

model ProblemTestCase {
  id        String          @id @default(cuid())
  problemId String
  problem   Problem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  kind      ProblemCaseKind
  input     Json
  expected  Json
  sortOrder Int             @default(0)

  @@index([problemId, kind])
  @@map("problem_test_cases")
}

model UserProblemStatus {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId     String
  problem       Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  solved        Boolean   @default(false)
  attempted     Boolean   @default(false)
  favorite      Boolean   @default(false)
  solvedAt      DateTime?
  lastAttemptAt DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([userId, problemId])
  @@index([userId, solved])
  @@map("user_problem_statuses")
}

model ProblemSubmission {
  id          String                  @id @default(cuid())
  userId      String?
  user        User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  problemId   String
  problem     Problem                 @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language    String
  code        String
  status      ProblemSubmissionStatus
  passed      Int                     @default(0)
  total       Int                     @default(0)
  runtimeMs   Int                     @default(0)
  memoryMb    Float                   @default(0)
  message     String?
  testResults Json?
  createdAt   DateTime                @default(now())

  @@index([problemId, createdAt])
  @@index([userId, createdAt])
  @@map("problem_submissions")
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model PendingSignup {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pending_signups")
}

// ── Follow system ─────────────────────────────────────────────────────────────

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

// ── Video ─────────────────────────────────────────────────────────────────────

model Video {
  id               String           @id @default(cuid())
  title            String
  description      String?
  type             VideoType        @default(LECTURE)
  visibility       VideoVisibility  @default(PUBLIC)
  subject          String?
  tags             String[]
  objectKey        String
  streamUrl        String?
  duration         Int?
  thumbnailUrl     String?
  views            Int              @default(0)
  likes            Int              @default(0)
  uploadedById     String
  uploader         User             @relation("VideoUploads", fields: [uploadedById], references: [id])
  comments         VideoComment[]
  watchHistory     WatchHistory[]
  moderationStatus ModerationStatus @default(APPROVED)
  moderationNote   String?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@index([moderationStatus])
  @@map("videos")
}

model VideoComment {
  id        String         @id @default(cuid())
  text      String
  videoId   String
  video     Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation("VideoComments", fields: [authorId], references: [id])
  likes     Int            @default(0)
  parentId  String?
  parent    VideoComment?  @relation("VideoCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   VideoComment[] @relation("VideoCommentReplies")
  createdAt DateTime       @default(now())

  @@index([videoId, parentId])
  @@index([parentId])
  @@map("video_comments")
}

// ── Reels ─────────────────────────────────────────────────────────────────────

model Reel {
  id               String           @id @default(cuid())
  title            String
  description      String?
  subject          String?
  tags             String[]
  videoUrl         String
  thumbnailUrl     String?
  duration         Int?
  visibility       VideoVisibility  @default(PUBLIC)
  views            Int              @default(0)
  likes            Int              @default(0)
  saves            Int              @default(0)
  shares           Int              @default(0)
  authorId         String
  author           User             @relation("UserReels", fields: [authorId], references: [id])
  comments         ReelComment[]
  moderationStatus ModerationStatus @default(APPROVED)
  moderationNote   String?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@index([moderationStatus])
  @@map("reels")
}

model ReelComment {
  id        String        @id @default(cuid())
  text      String
  reelId    String
  reel      Reel          @relation(fields: [reelId], references: [id], onDelete: Cascade)
  authorId  String
  likes     Int           @default(0)
  parentId  String?
  parent    ReelComment?  @relation("ReelCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ReelComment[] @relation("ReelCommentReplies")
  createdAt DateTime      @default(now())

  @@index([reelId, parentId])
  @@index([parentId])
  @@map("reel_comments")
}

// ── Posts (text/image posts like Instagram/LinkedIn) ─────────────────────────

model Post {
  id               String           @id @default(cuid())
  content          String // text content
  mediaUrls        String[] // images/attachments
  subject          String?
  tags             String[]
  visibility       VideoVisibility  @default(PUBLIC)
  views            Int              @default(0)
  likes            Int              @default(0)
  shares           Int              @default(0)
  authorId         String
  author           User             @relation("UserPosts", fields: [authorId], references: [id])
  comments         PostComment[]
  moderationStatus ModerationStatus @default(APPROVED)
  moderationNote   String?
  reviewedAt       DateTime?
  scheduledAt      DateTime? // If set, post is scheduled for future publishing
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@index([moderationStatus])
  @@map("posts")
}

model PostComment {
  id        String        @id @default(cuid())
  text      String
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  likes     Int           @default(0)
  parentId  String?
  parent    PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("PostCommentReplies")
  createdAt DateTime      @default(now())

  @@index([postId, parentId])
  @@index([parentId])
  @@map("post_comments")
}

// ── Content Likes (unified) ───────────────────────────────────────────────────

model ContentLike {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation("UserLikes", fields: [userId], references: [id], onDelete: Cascade)
  contentType ContentType
  contentId   String
  createdAt   DateTime    @default(now())

  @@unique([userId, contentType, contentId])
  @@map("content_likes")
}

// Saved content (bookmarks)
model SavedContent {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType ContentType
  contentId   String
  createdAt   DateTime    @default(now())

  @@unique([userId, contentType, contentId])
  @@map("saved_content")
}

// ── LiveSession ───────────────────────────────────────────────────────────────

model LiveSession {
  id           String          @id @default(cuid())
  title        String
  subject      String?
  creatorId    String          @map("teacherId")
  creator      User            @relation("LiveSessions", fields: [creatorId], references: [id])
  visibility   VideoVisibility @default(PUBLIC)
  streamKey    String          @unique @default(cuid())
  isActive     Boolean         @default(false)
  viewers      Int             @default(0)
  startedAt    DateTime?
  endedAt      DateTime?
  recordingUrl String?
  createdAt    DateTime        @default(now())

  @@map("live_sessions")
}

// ── Wallet & Payments ─────────────────────────────────────────────────────────

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // "CREDIT_PURCHASE" | "API_PURCHASE" | "WALLET_TOPUP" | "CREDIT_USAGE"
  amount      Float // amount in INR
  description String?
  reference   String? // payment ID from Razorpay / Stripe
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([reference])
  @@map("transactions")
}

model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float // amount in INR
  type        String // "CREDIT" | "DEBIT"
  status      String // "COMPLETED" | "PENDING" | "FAILED"
  reference   String?
  description String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model AssistantSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  String // JSON string of message array
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId, updatedAt])
  @@map("assistant_sessions")
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String // "like", "comment", "follow", "system"
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model CourseCategory {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String?
  approxLabel String?
  level       CourseLevel
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  courses Course[]

  @@index([isActive, sortOrder])
  @@map("course_categories")
}

model Course {
  id             String         @id @default(cuid())
  categoryId     String
  category       CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug           String         @unique
  code           String         @unique
  title          String
  description    String?
  summary        String?
  tags           String[]
  level          CourseLevel
  durationMonths Int            @default(0)
  governingBody  GoverningBody  @default(NONE)
  status         PublishStatus  @default(DRAFT)
  isPublished    Boolean        @default(false)
  isArchived     Boolean        @default(false)
  thumbnailUrl   String?
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  publishedAt    DateTime?

  modules     CourseModule[]
  enrollments CourseEnrollment[]

  @@index([categoryId, isPublished, isArchived])
  @@index([level])
  @@index([status])
  @@map("courses")
}

model CourseModule {
  id          String        @id @default(cuid())
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String?
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lessons CourseLesson[]

  @@unique([courseId, slug])
  @@index([courseId, sortOrder])
  @@map("course_modules")
}

model CourseLesson {
  id          String        @id @default(cuid())
  moduleId    String
  module      CourseModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String?
  content     String?
  videoUrl    String?
  resourceUrl String?
  durationMin Int           @default(0)
  status      PublishStatus @default(DRAFT)
  isFree      Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  progress CourseLessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
  @@map("course_lessons")
}

model CourseEnrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonProgress CourseLessonProgress[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_enrollments")
}

model CourseLessonProgress {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed    Boolean          @default(false)
  completedAt  DateTime?
  updatedAt    DateTime         @updatedAt

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
  @@map("course_lesson_progress")
}

// ── Watch History ─────────────────────────────────────────────────────────────

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  progress  Float    @default(0) // 0-1 (percentage watched)
  duration  Float    @default(0) // video duration in seconds
  watchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, watchedAt(sort: Desc)])
  @@map("watch_history")
}

// ── Creator Categories & Tags ────────────────────────────────────────────────

model CreatorCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags CreatorTag[]

  @@index([isActive, sortOrder])
  @@map("creator_categories")
}

model CreatorTag {
  id         String          @id @default(cuid())
  name       String
  slug       String
  categoryId String
  category   CreatorCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  usageCount Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())

  @@unique([categoryId, slug])
  @@index([slug])
  @@map("creator_tags")
}

// ── Creator Verification ─────────────────────────────────────────────────────

model CreatorVerification {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       VerificationStatus @default(PENDING)
  type         String // "BLUE_BADGE", "IDENTITY", "PROFESSIONAL"
  documentUrl  String?
  documentType String? // "AADHAAR", "PASSPORT", "DRIVING_LICENSE", "PAN"
  legalName    String?
  responseNote String?
  reviewedBy   String?
  submittedAt  DateTime           @default(now())
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId, status])
  @@index([status, submittedAt])
  @@map("creator_verifications")
}

// ── Creator Goals ─────────────────────────────────────────────────────────────

model CreatorGoal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  targetValue  Int?
  currentValue Int       @default(0)
  metric       String // "followers", "views", "posts", "reels", "earnings"
  deadline     DateTime?
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, completed])
  @@map("creator_goals")
}

// ── Creator Interests ─────────────────────────────────────────────────────────

model CreatorInterest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest  String // e.g. "technology", "education", "music"
  createdAt DateTime @default(now())

  @@unique([userId, interest])
  @@index([userId])
  @@map("creator_interests")
}

// ── Admin Actions ─────────────────────────────────────────────────────────────

model AdminAction {
  id         String          @id @default(cuid())
  adminId    String
  admin      User            @relation("AdminActions", fields: [adminId], references: [id])
  actionType AdminActionType
  targetType String // "USER", "CONTENT", "VERIFICATION"
  targetId   String
  note       String?
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_actions")
}

// ── Creator Analytics Events ──────────────────────────────────────────────────

model CreatorAnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String // "PROFILE_VIEW", "CLICK", "FOLLOW", "SESSION", "SEARCH_IMPRESSION"
  metadata  Json? // { source, targetId, targetType, sessionId }
  createdAt DateTime @default(now())

  @@index([userId, eventType, createdAt(sort: Desc)])
  @@index([eventType, createdAt])
  @@map("creator_analytics_events")
}

// ── Phase 2: Content Creation Enums ──────────────────────────────────────────

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum ScheduleRecurrence {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

// ── Phase 2: Hashtag System ──────────────────────────────────────────────────

model Hashtag {
  id         String   @id @default(cuid())
  name       String   @unique // lowercase, no # prefix
  slug       String   @unique
  usageCount Int      @default(0)
  trending   Boolean  @default(false)
  trendScore Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([usageCount])
  @@index([trending, trendScore])
  @@map("hashtags")
}

// ── Phase 2: Mention System ──────────────────────────────────────────────────

model Mention {
  id          String      @id @default(cuid())
  mentionedId String // userId who was mentioned
  mentionerId String // userId who mentioned
  contentType ContentType
  contentId   String
  createdAt   DateTime    @default(now())

  @@index([mentionedId, createdAt])
  @@index([contentType, contentId])
  @@map("mentions")
}

// ── Phase 2: Content Schedule ────────────────────────────────────────────────

model ContentSchedule {
  id          String             @id @default(cuid())
  userId      String
  contentType ContentType
  contentId   String
  scheduledAt DateTime
  publishedAt DateTime?
  status      ContentStatus      @default(SCHEDULED)
  recurrence  ScheduleRecurrence @default(NONE)
  timezone    String             @default("Asia/Kolkata")
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, status])
  @@index([scheduledAt, status])
  @@map("content_schedules")
}

// ── Phase 2: Content Version History ─────────────────────────────────────────

model ContentVersion {
  id          String      @id @default(cuid())
  contentType ContentType
  contentId   String
  userId      String
  version     Int         @default(1)
  data        Json // Snapshot of content at this version
  changeNote  String?
  createdAt   DateTime    @default(now())

  @@unique([contentType, contentId, version])
  @@index([contentType, contentId])
  @@map("content_versions")
}

// ── Phase 2: Media Asset Library ─────────────────────────────────────────────

model MediaAsset {
  id           String       @id @default(cuid())
  userId       String
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  url          String
  thumbnailUrl String?
  width        Int?
  height       Int?
  duration     Float? // seconds, for video/audio
  folderId     String?
  folder       MediaFolder? @relation(fields: [folderId], references: [id])
  tags         String[]
  isFavorite   Boolean      @default(false)
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, mimeType])
  @@index([folderId])
  @@map("media_assets")
}

model MediaFolder {
  id        String       @id @default(cuid())
  userId    String
  name      String
  parentId  String?
  assets    MediaAsset[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, name, parentId])
  @@map("media_folders")
}

// ── Phase 2: Link Preview Cache ──────────────────────────────────────────────

model LinkPreview {
  id          String   @id @default(cuid())
  url         String   @unique
  title       String?
  description String?
  imageUrl    String?
  domain      String?
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime // Cache expiry

  @@index([url])
  @@map("link_previews")
}

// ── Phase 3: Feed Engine Enums ──────────────────────────────────────────────

enum FeedType {
  HOME
  FOLLOWING
  CREATOR
  TRENDING
  EXPLORE
  VIDEO
  REEL
  STORY
  LOCAL
  INTEREST
  HASHTAG
  SAVED
  GROUP
  EVENT
}

enum TrendingWindow {
  ONE_HOUR
  TWENTY_FOUR_HOURS
  SEVEN_DAYS
  THIRTY_DAYS
}

enum BehaviorType {
  VIEW
  CLICK
  WATCH
  LIKE
  COMMENT
  SHARE
  SAVE
  SEARCH
  FOLLOW
  SCROLL
  SKIP
}

enum ContentCategoryType {
  TECHNOLOGY
  EDUCATION
  ENTERTAINMENT
  GAMING
  SPORTS
  BUSINESS
  NEWS
  SCIENCE
  LIFESTYLE
  TRAVEL
  FOOD
  MUSIC
  ART
  HEALTH
  FASHION
}

// ── Phase 3: Feed Item & Ranking ────────────────────────────────────────────

model FeedItem {
  id          String      @id @default(cuid())
  userId      String // target user who sees this in feed
  contentType ContentType
  contentId   String
  feedType    FeedType    @default(HOME)
  score       Float       @default(0) // computed ranking score
  boostScore  Float       @default(0) // additional boost from early engagement
  reason      String? // "following", "interest", "trending", "recommended"
  seen        Boolean     @default(false)
  interacted  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  expiresAt   DateTime? // feed items can expire

  @@index([userId, feedType, score])
  @@index([userId, seen, createdAt])
  @@index([contentType, contentId])
  @@index([createdAt])
  @@map("feed_items")
}

model FeedRanking {
  id             String      @id @default(cuid())
  contentType    ContentType
  contentId      String
  engagementRate Float       @default(0)
  watchTime      Float       @default(0) // avg watch time in seconds
  shareRate      Float       @default(0)
  saveRate       Float       @default(0)
  commentQuality Float       @default(0) // avg quality score of comments
  completionRate Float       @default(0) // for videos: % watched to end
  qualityScore   Float       @default(0) // overall content quality
  trustScore     Float       @default(0) // creator trust score
  recencyScore   Float       @default(0)
  totalScore     Float       @default(0) // final computed score
  impressions    Int         @default(0)
  clicks         Int         @default(0)
  ctr            Float       @default(0) // click-through rate
  updatedAt      DateTime    @updatedAt
  createdAt      DateTime    @default(now())

  @@unique([contentType, contentId])
  @@index([totalScore])
  @@index([contentType, totalScore])
  @@map("feed_rankings")
}

// ── Phase 3: User Behavior & Interest Graph ─────────────────────────────────

model UserBehavior {
  id           String       @id @default(cuid())
  userId       String
  behaviorType BehaviorType
  contentType  ContentType?
  contentId    String?
  targetUserId String? // for follow, profile view
  categoryId   String? // content category if known
  hashtag      String? // if interacting with hashtag content
  duration     Float? // time spent in seconds (for watch/scroll)
  metadata     Json?
  createdAt    DateTime     @default(now())

  @@index([userId, behaviorType, createdAt])
  @@index([userId, contentType, createdAt])
  @@index([userId, createdAt])
  @@map("user_behaviors")
}

model UserInterestProfile {
  id              String              @id @default(cuid())
  userId          String
  category        ContentCategoryType
  affinityScore   Float               @default(0) // 0-100
  interactions    Int                 @default(0)
  lastInteraction DateTime?
  decayFactor     Float               @default(1.0) // decreases over time
  updatedAt       DateTime            @updatedAt
  createdAt       DateTime            @default(now())

  @@unique([userId, category])
  @@index([userId, affinityScore])
  @@map("user_interest_profiles")
}

model UserCreatorAffinity {
  id              String    @id @default(cuid())
  userId          String
  creatorId       String
  affinityScore   Float     @default(0) // based on views, likes, watch time
  interactions    Int       @default(0)
  lastInteraction DateTime?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@unique([userId, creatorId])
  @@index([userId, affinityScore])
  @@map("user_creator_affinities")
}

// ── Phase 3: Trending System ────────────────────────────────────────────────

model TrendingItem {
  id          String         @id @default(cuid())
  contentType ContentType? // null for hashtags/topics
  contentId   String?
  hashtag     String? // if trending hashtag
  topic       String? // if trending topic
  creatorId   String? // if trending creator
  window      TrendingWindow @default(TWENTY_FOUR_HOURS)
  trendScore  Float          @default(0)
  velocity    Float          @default(0) // rate of score increase
  impressions Int            @default(0)
  engagements Int            @default(0)
  rank        Int            @default(0) // position in trending list
  startedAt   DateTime       @default(now())
  peakedAt    DateTime?
  expiresAt   DateTime
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([window, trendScore])
  @@index([window, rank])
  @@index([hashtag, window])
  @@index([expiresAt])
  @@map("trending_items")
}

// ── Phase 3: Recommendations ────────────────────────────────────────────────

model Recommendation {
  id         String       @id @default(cuid())
  userId     String
  type       String // "creator", "content", "hashtag", "interest"
  targetType ContentType?
  targetId   String? // content/creator/hashtag id
  targetName String? // display name for the recommendation
  score      Float        @default(0)
  reason     String? // "similar_interests", "popular_in_category", etc.
  dismissed  Boolean      @default(false)
  clicked    Boolean      @default(false)
  createdAt  DateTime     @default(now())
  expiresAt  DateTime?

  @@index([userId, type, score])
  @@index([userId, dismissed, createdAt])
  @@map("recommendations")
}

// ── Phase 3: Content Category Assignment ────────────────────────────────────

model ContentCategoryAssignment {
  id          String              @id @default(cuid())
  contentType ContentType
  contentId   String
  category    ContentCategoryType
  confidence  Float               @default(0) // 0-1 confidence of classification
  autoTagged  Boolean             @default(false)
  createdAt   DateTime            @default(now())

  @@unique([contentType, contentId, category])
  @@index([category, confidence])
  @@index([contentType, contentId])
  @@map("content_category_assignments")
}

// ── Phase 3: Feed Analytics ─────────────────────────────────────────────────

model FeedAnalytics {
  id              String   @id @default(cuid())
  userId          String
  feedType        FeedType
  date            DateTime @db.Date // aggregated per day
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  ctr             Float    @default(0)
  avgWatchTime    Float    @default(0)
  sessionDuration Float    @default(0)
  scrollDepth     Float    @default(0) // 0-100 percentage
  itemsSeen       Int      @default(0)
  itemsInteracted Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([userId, feedType, date])
  @@index([userId, date])
  @@index([feedType, date])
  @@map("feed_analytics")
}

// ── Phase 4: Reels Studio Enums ─────────────────────────────────────────────

enum ReelStatus {
  DRAFT
  PROCESSING
  READY
  SCHEDULED
  PUBLISHED
  ARCHIVED
  FAILED
}

enum ReelAudioType {
  ORIGINAL
  LIBRARY
  UPLOADED
  TRENDING
}

enum StickerType {
  EMOJI
  GIF
  POLL
  QUESTION
  COUNTDOWN
  LOCATION
  MENTION
  HASHTAG
  MUSIC
  LINK
  QUIZ
}

enum EffectType {
  FILTER
  COLOR_CORRECTION
  BRIGHTNESS
  CONTRAST
  SATURATION
  BLUR
  VIGNETTE
  SPEED
  REVERSE
}

enum TextAnimation {
  NONE
  FADE_IN
  SLIDE_UP
  SLIDE_DOWN
  TYPEWRITER
  BOUNCE
  SCALE
  GLITCH
}

// ── Phase 4: Reel Draft ─────────────────────────────────────────────────────

model ReelDraft {
  id              String          @id @default(cuid())
  userId          String
  title           String?
  caption         String?
  description     String?
  hashtags        String[]        @default([])
  mentions        String[]        @default([])
  category        String?
  videoUrl        String?
  thumbnailUrl    String?
  duration        Float? // seconds
  visibility      VideoVisibility @default(PUBLIC)
  status          ReelStatus      @default(DRAFT)
  scheduledAt     DateTime?
  settings        Json? // { commentsEnabled, remixEnabled, downloadEnabled, sharingEnabled }
  editData        Json? // full editor state (clips, effects, audio, text, stickers)
  processingJobId String?
  version         Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  audioTracks  ReelAudioTrack[]
  textOverlays ReelTextOverlay[]
  effects      ReelEffect[]
  stickers     ReelSticker[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("reel_drafts")
}

// ── Phase 4: Audio System ───────────────────────────────────────────────────

model ReelAudio {
  id           String        @id @default(cuid())
  name         String
  artistName   String?
  audioUrl     String
  duration     Float // seconds
  type         ReelAudioType @default(LIBRARY)
  coverUrl     String?
  genre        String?
  mood         String?
  usageCount   Int           @default(0)
  isTrending   Boolean       @default(false)
  trendScore   Float         @default(0)
  uploadedById String? // null = system/library audio
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tracks ReelAudioTrack[]

  @@index([type, usageCount])
  @@index([isTrending, trendScore])
  @@index([name])
  @@map("reel_audios")
}

model ReelAudioTrack {
  id        String    @id @default(cuid())
  draftId   String
  draft     ReelDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  audioId   String
  audio     ReelAudio @relation(fields: [audioId], references: [id])
  startTime Float     @default(0) // where in the reel this track starts
  endTime   Float? // where it ends (null = entire duration)
  volume    Float     @default(1.0) // 0.0 to 1.0
  fadeIn    Float     @default(0) // seconds
  fadeOut   Float     @default(0) // seconds
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([draftId])
  @@index([audioId])
  @@map("reel_audio_tracks")
}

// ── Phase 4: Text & Captions ────────────────────────────────────────────────

model ReelTextOverlay {
  id              String        @id @default(cuid())
  draftId         String
  draft           ReelDraft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  text            String
  fontFamily      String        @default("Inter")
  fontSize        Int           @default(24)
  fontWeight      String        @default("bold")
  color           String        @default("#FFFFFF")
  backgroundColor String? // null = transparent
  positionX       Float         @default(50) // percentage (0-100)
  positionY       Float         @default(50)
  rotation        Float         @default(0) // degrees
  alignment       String        @default("center") // left, center, right
  animation       TextAnimation @default(NONE)
  startTime       Float         @default(0) // when to show (seconds)
  endTime         Float? // when to hide (null = always visible)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([draftId])
  @@map("reel_text_overlays")
}

// ── Phase 4: Effects ────────────────────────────────────────────────────────

model ReelEffect {
  id         String     @id @default(cuid())
  draftId    String
  draft      ReelDraft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  effectType EffectType
  intensity  Float      @default(0.5) // 0.0 to 1.0
  startTime  Float      @default(0)
  endTime    Float? // null = entire duration
  parameters Json? // type-specific params (e.g., blur radius, speed factor)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([draftId])
  @@map("reel_effects")
}

// ── Phase 4: Stickers ───────────────────────────────────────────────────────

model ReelSticker {
  id          String      @id @default(cuid())
  draftId     String
  draft       ReelDraft   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  stickerType StickerType
  content     String // emoji char, GIF url, poll question, etc.
  positionX   Float       @default(50)
  positionY   Float       @default(50)
  scale       Float       @default(1.0)
  rotation    Float       @default(0)
  startTime   Float       @default(0)
  endTime     Float?
  metadata    Json? // type-specific data (poll options, countdown date, etc.)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())

  @@index([draftId])
  @@map("reel_stickers")
}

// ── Phase 4: Reel Analytics ─────────────────────────────────────────────────

model ReelAnalyticsEvent {
  id         String   @id @default(cuid())
  reelId     String
  userId     String? // null for anonymous views
  eventType  String // "view", "complete", "like", "comment", "share", "save", "remix"
  watchTime  Float? // seconds watched
  percentage Float? // completion percentage 0-100
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([reelId, eventType])
  @@index([reelId, createdAt])
  @@index([userId, createdAt])
  @@map("reel_analytics_events")
}

// ── Phase 4: Reel Categories ────────────────────────────────────────────────

model ReelCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  color       String?
  description String?
  reelCount   Int      @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("reel_categories")
}

// ── Phase 5: Video Studio Enums ─────────────────────────────────────────────

enum VideoProcessingStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum VideoResolution {
  RES_240P
  RES_360P
  RES_480P
  RES_720P
  RES_1080P
  RES_1440P
  RES_4K
}

enum SubtitleFormat {
  SRT
  VTT
}

enum PremiereStatus {
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

// ── Phase 5: Video Draft ────────────────────────────────────────────────────

model VideoDraft {
  id               String                @id @default(cuid())
  userId           String
  title            String?
  description      String?
  category         String?
  tags             String[]              @default([])
  hashtags         String[]              @default([])
  mentions         String[]              @default([])
  videoUrl         String?
  objectKey        String?
  thumbnailUrl     String?
  duration         Float? // seconds
  resolution       String? // e.g. "1920x1080"
  fileSize         Int? // bytes
  mimeType         String?
  visibility       VideoVisibility       @default(PUBLIC)
  status           ReelStatus            @default(DRAFT) // reuse: DRAFT, PROCESSING, READY, SCHEDULED, PUBLISHED, ARCHIVED, FAILED
  processingStatus VideoProcessingStatus @default(PENDING)
  processingJobId  String?
  scheduledAt      DateTime?
  premiereAt       DateTime?
  settings         Json? // { commentsEnabled, downloadEnabled, sharingEnabled, embeddingEnabled }
  editData         Json? // editor state (trim points, splits, etc.)
  chapterMarkers   Json? // [{ time, title }]
  version          Int                   @default(1)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  thumbnails  VideoThumbnail[]
  subtitles   VideoSubtitle[]
  resolutions VideoResolutionFile[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("video_drafts")
}

// ── Phase 5: Video Resolution Files (Multi-quality) ─────────────────────────

model VideoResolutionFile {
  id         String                @id @default(cuid())
  draftId    String
  draft      VideoDraft            @relation(fields: [draftId], references: [id], onDelete: Cascade)
  resolution VideoResolution
  url        String
  objectKey  String?
  fileSize   Int? // bytes
  bitrate    Int? // kbps
  codec      String? // e.g. "h264", "vp9"
  status     VideoProcessingStatus @default(PENDING)
  createdAt  DateTime              @default(now())

  @@unique([draftId, resolution])
  @@index([draftId])
  @@map("video_resolution_files")
}

// ── Phase 5: Video Thumbnails ───────────────────────────────────────────────

model VideoThumbnail {
  id         String     @id @default(cuid())
  draftId    String
  draft      VideoDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  url        String
  timestamp  Float? // frame time in seconds (null for custom upload)
  isSelected Boolean    @default(false)
  isCustom   Boolean    @default(false)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([draftId, isSelected])
  @@map("video_thumbnails")
}

// ── Phase 5: Subtitle System ────────────────────────────────────────────────

model VideoSubtitle {
  id              String         @id @default(cuid())
  draftId         String?
  draft           VideoDraft?    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  videoId         String? // can also be attached to published Video
  language        String         @default("en")
  label           String         @default("English")
  format          SubtitleFormat @default(VTT)
  url             String
  isDefault       Boolean        @default(false)
  isAutoGenerated Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([draftId])
  @@index([videoId])
  @@map("video_subtitles")
}

// ── Phase 5: Playlist System ────────────────────────────────────────────────

model VideoPlaylist {
  id            String          @id @default(cuid())
  userId        String
  title         String
  description   String?
  coverUrl      String?
  visibility    VideoVisibility @default(PUBLIC)
  isFeatured    Boolean         @default(false)
  videoCount    Int             @default(0)
  totalDuration Float           @default(0) // total seconds
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items VideoPlaylistItem[]

  @@index([userId, createdAt])
  @@index([userId, isFeatured])
  @@map("video_playlists")
}

model VideoPlaylistItem {
  id         String        @id @default(cuid())
  playlistId String
  playlist   VideoPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  videoId    String
  sortOrder  Int           @default(0)
  addedAt    DateTime      @default(now())

  @@unique([playlistId, videoId])
  @@index([playlistId, sortOrder])
  @@map("video_playlist_items")
}

// ── Phase 5: Video Folders/Collections ──────────────────────────────────────

model VideoFolder {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  parentId    String?
  videoCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name, parentId])
  @@index([userId])
  @@map("video_folders")
}

// ── Phase 5: Premiere System ────────────────────────────────────────────────

model VideoPremiere {
  id            String         @id @default(cuid())
  videoId       String? // linked after publish
  draftId       String?
  userId        String
  title         String
  description   String?
  thumbnailUrl  String?
  scheduledAt   DateTime
  status        PremiereStatus @default(UPCOMING)
  reminderCount Int            @default(0)
  viewerCount   Int            @default(0)
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, status])
  @@index([scheduledAt, status])
  @@map("video_premieres")
}

// ── Phase 5: Video Analytics ────────────────────────────────────────────────

model VideoAnalyticsEvent {
  id         String   @id @default(cuid())
  videoId    String
  userId     String?
  eventType  String // "view", "complete", "like", "comment", "share", "save", "embed"
  watchTime  Float? // seconds
  percentage Float? // retention/completion %
  timestamp  Float? // where in the video the event happened
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([videoId, eventType])
  @@index([videoId, createdAt])
  @@index([userId, createdAt])
  @@map("video_analytics_events")
}

// ── Phase 5: Video Retention Data ───────────────────────────────────────────

model VideoRetention {
  id        String   @id @default(cuid())
  videoId   String
  bucket    Int // percentage bucket (0-100, in 5% increments: 0, 5, 10, ..., 100)
  viewCount Int      @default(0) // how many viewers reached this point
  updatedAt DateTime @updatedAt

  @@unique([videoId, bucket])
  @@index([videoId])
  @@map("video_retention")
}

// ── Phase 7: Stories Studio ─────────────────────────────────────────────────

enum StoryMediaType {
  IMAGE
  VIDEO
  TEXT
  LINK
  POLL
  QUESTION
}

enum StoryVisibility {
  PUBLIC
  FOLLOWERS
  SUBSCRIBERS
  CLOSE_FRIENDS
  PRIVATE
}

enum StoryStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  EXPIRED
  DELETED
}

model Story {
  id              String          @id @default(cuid())
  creatorId       String
  mediaType       StoryMediaType
  mediaUrl        String?
  thumbnailUrl    String?
  caption         String?
  visibility      StoryVisibility @default(PUBLIC)
  status          StoryStatus     @default(DRAFT)
  duration        Float? // seconds (default 5 for images, video length for videos)
  linkUrl         String?
  allowReplies    Boolean         @default(true)
  allowSharing    Boolean         @default(true)
  settings        Json? // { commentsEnabled, downloadEnabled }
  metadata        Json? // { filters, overlays, editorState }
  viewCount       Int             @default(0)
  replyCount      Int             @default(0)
  exitCount       Int             @default(0)
  completionCount Int             @default(0)
  linkClicks      Int             @default(0)
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  stickers       StorySticker[]
  music          StoryMusic?
  replies        StoryReply[]
  analytics      StoryAnalytics?
  interactions   StoryInteraction[]
  highlightItems StoryHighlightItem[]
  views          StoryView[]

  @@index([creatorId, status])
  @@index([creatorId, publishedAt])
  @@index([expiresAt, status])
  @@map("stories")
}

model StoryDraft {
  id           String          @id @default(cuid())
  creatorId    String
  mediaType    StoryMediaType?
  mediaUrl     String?
  thumbnailUrl String?
  caption      String?
  visibility   StoryVisibility @default(PUBLIC)
  duration     Float?
  linkUrl      String?
  settings     Json?
  editData     Json? // editor state: crop, trim, filters, overlays
  stickers     Json? // array of sticker position configs
  textOverlays Json? // array of text overlay configs
  musicConfig  Json? // music track config
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([creatorId, updatedAt])
  @@map("story_drafts")
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId  String
  completed Boolean  @default(false)
  duration  Float? // how long they viewed (seconds)
  viewedAt  DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([storyId, viewedAt])
  @@index([viewerId])
  @@map("story_views")
}

model StorySticker {
  id            String      @id @default(cuid())
  storyId       String
  story         Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  stickerType   StickerType
  content       Json? // type-specific data: poll options, question text, countdown target
  positionX     Float       @default(50)
  positionY     Float       @default(50)
  scale         Float       @default(1.0)
  rotation      Float       @default(0)
  width         Float?
  height        Float?
  sortOrder     Int         @default(0)
  responseCount Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([storyId])
  @@map("story_stickers")
}

model StoryMusic {
  id        String   @id @default(cuid())
  storyId   String   @unique
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  audioId   String? // reference to audio library
  name      String
  artist    String?
  audioUrl  String
  startTime Float    @default(0)
  endTime   Float?
  volume    Float    @default(0.8)
  createdAt DateTime @default(now())

  @@map("story_music")
}

model StoryReply {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  replyType String   @default("TEXT") // TEXT, EMOJI, REACTION
  content   String?
  emoji     String?
  createdAt DateTime @default(now())

  @@index([storyId, createdAt])
  @@index([userId])
  @@map("story_replies")
}

model StoryHighlight {
  id         String   @id @default(cuid())
  creatorId  String
  title      String
  coverUrl   String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  storyCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items StoryHighlightItem[]

  @@index([creatorId, updatedAt])
  @@map("story_highlights")
}

model StoryHighlightItem {
  id          String         @id @default(cuid())
  highlightId String
  highlight   StoryHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  storyId     String
  story       Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  sortOrder   Int            @default(0)
  addedAt     DateTime       @default(now())

  @@unique([highlightId, storyId])
  @@index([highlightId, sortOrder])
  @@map("story_highlight_items")
}

model StoryAnalytics {
  id                  String   @id @default(cuid())
  storyId             String   @unique
  story               Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  views               Int      @default(0)
  uniqueViews         Int      @default(0)
  reach               Int      @default(0)
  exits               Int      @default(0)
  completionRate      Float    @default(0)
  replies             Int      @default(0)
  stickerInteractions Int      @default(0)
  linkClicks          Int      @default(0)
  shares              Int      @default(0)
  profileVisits       Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@map("story_analytics")
}

model StoryInteraction {
  id            String   @id @default(cuid())
  storyId       String
  story         Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  type          String // POLL, QUESTION, QUIZ, COUNTDOWN, SLIDER, EMOJI_SLIDER
  config        Json? // type-specific configuration
  responseCount Int      @default(0)
  createdAt     DateTime @default(now())

  responses StoryInteractionResponse[]

  @@index([storyId])
  @@map("story_interactions")
}

model StoryInteractionResponse {
  id            String           @id @default(cuid())
  interactionId String
  interaction   StoryInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  userId        String
  responseData  Json?
  createdAt     DateTime         @default(now())

  @@unique([interactionId, userId])
  @@index([interactionId])
  @@index([userId])
  @@map("story_interaction_responses")
}

model StoryAnalyticsEvent {
  id        String   @id @default(cuid())
  storyId   String
  userId    String?
  eventType String // VIEW, COMPLETE, EXIT, REPLY, STICKER_TAP, LINK_CLICK, SHARE, FORWARD, SCREENSHOT
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([storyId, eventType])
  @@index([storyId, createdAt])
  @@index([userId, createdAt])
  @@map("story_analytics_events")
}

model StoryAudioLibrary {
  id         String   @id @default(cuid())
  name       String
  artistName String?
  audioUrl   String
  coverUrl   String?
  duration   Float? // seconds
  genre      String?
  mood       String?
  isTrending Boolean  @default(false)
  isActive   Boolean  @default(true)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([isTrending, usageCount])
  @@index([genre])
  @@map("story_audio_library")
}

// ── Phase 8: Audience Management System ─────────────────────────────────────────

enum AudienceActivityLevel {
  VERY_ACTIVE
  ACTIVE
  MODERATE
  LOW
  INACTIVE
}

enum AudienceSegmentType {
  DYNAMIC
  MANUAL
  SMART
}

enum FanTier {
  REGULAR
  LOYAL
  SUPER_FAN
  VIP
}

enum JourneyStage {
  DISCOVERED
  FOLLOWED
  ENGAGED
  LOYAL_FAN
  SUBSCRIBER
  ADVOCATE
}

enum CommunityReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum CommunityReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  INAPPROPRIATE
  FAKE_ACCOUNT
  BOT
  OTHER
}

// ── Phase 8: Audience Profile ───────────────────────────────────────────────────

model AudienceProfile {
  id                String                @id @default(cuid())
  creatorId         String
  userId            String
  followedAt        DateTime              @default(now())
  engagementScore   Float                 @default(0)
  loyaltyScore      Float                 @default(0)
  activityLevel     AudienceActivityLevel @default(MODERATE)
  fanTier           FanTier               @default(REGULAR)
  interests         String[]              @default([])
  location          Json? // { country, region, city }
  demographics      Json? // { ageGroup, language, device, platform }
  lastInteractionAt DateTime?
  totalInteractions Int                   @default(0)
  totalLikes        Int                   @default(0)
  totalComments     Int                   @default(0)
  totalShares       Int                   @default(0)
  totalSaves        Int                   @default(0)
  storyInteractions Int                   @default(0)
  reelInteractions  Int                   @default(0)
  videoInteractions Int                   @default(0)
  liveInteractions  Int                   @default(0)
  isFavorite        Boolean               @default(false)
  isVIP             Boolean               @default(false)
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  segmentMemberships AudienceSegmentMember[]
  tags               AudienceTag[]

  @@unique([creatorId, userId])
  @@index([creatorId, engagementScore])
  @@index([creatorId, fanTier])
  @@index([creatorId, activityLevel])
  @@index([creatorId, lastInteractionAt])
  @@map("audience_profiles")
}

// ── Phase 8: Audience Segments ──────────────────────────────────────────────────

model AudienceSegment {
  id          String              @id @default(cuid())
  creatorId   String
  name        String
  description String?
  segmentType AudienceSegmentType @default(DYNAMIC)
  criteria    Json // filter criteria object
  memberCount Int                 @default(0)
  color       String?
  icon        String?
  isSystem    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  members AudienceSegmentMember[]

  @@index([creatorId, segmentType])
  @@index([creatorId, isSystem])
  @@map("audience_segments")
}

model AudienceSegmentMember {
  id        String          @id @default(cuid())
  segmentId String
  segment   AudienceSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  profileId String
  profile   AudienceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  addedAt   DateTime        @default(now())

  @@unique([segmentId, profileId])
  @@index([segmentId])
  @@index([profileId])
  @@map("audience_segment_members")
}

// ── Phase 8: Audience Tags ──────────────────────────────────────────────────────

model AudienceTag {
  id          String          @id @default(cuid())
  creatorId   String
  profileId   String
  profile     AudienceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag         String
  isAutomatic Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@unique([profileId, tag])
  @@index([creatorId, tag])
  @@index([profileId])
  @@map("audience_tags")
}

// ── Phase 8: Audience Insights ──────────────────────────────────────────────────

model AudienceInsight {
  id                 String   @id @default(cuid())
  creatorId          String
  date               DateTime
  totalFollowers     Int      @default(0)
  newFollowers       Int      @default(0)
  unfollows          Int      @default(0)
  netGrowth          Int      @default(0)
  activeAudience     Int      @default(0)
  returningViewers   Int      @default(0)
  newViewers         Int      @default(0)
  retentionRate      Float    @default(0)
  churnRate          Float    @default(0)
  avgEngagementScore Float    @default(0)
  topCountries       Json? // [{ country, count }]
  topInterests       Json? // [{ interest, count }]
  demographics       Json? // { ageGroups, languages, devices, platforms }
  createdAt          DateTime @default(now())

  @@unique([creatorId, date])
  @@index([creatorId, date])
  @@map("audience_insights")
}

// ── Phase 8: Fan Relationships ──────────────────────────────────────────────────

model FanRelationship {
  id                  String    @id @default(cuid())
  creatorId           String
  userId              String
  tier                FanTier   @default(REGULAR)
  isFavorite          Boolean   @default(false)
  isVIP               Boolean   @default(false)
  notes               String?
  interactionTimeline Json? // [{ type, date, content }]
  totalSpent          Float     @default(0)
  subscribedAt        DateTime?
  firstInteractionAt  DateTime?
  lastInteractionAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([creatorId, userId])
  @@index([creatorId, tier])
  @@index([creatorId, isFavorite])
  @@index([creatorId, lastInteractionAt])
  @@map("fan_relationships")
}

// ── Phase 8: Community Moderators ───────────────────────────────────────────────

model CommunityModerator {
  id          String   @id @default(cuid())
  creatorId   String
  userId      String
  role        String   @default("moderator")
  permissions Json? // { canBan, canMute, canDeleteComments, canPinComments, canManageReports }
  assignedAt  DateTime @default(now())
  isActive    Boolean  @default(true)

  @@unique([creatorId, userId])
  @@index([creatorId, isActive])
  @@map("community_moderators")
}

// ── Phase 8: Community Reports ──────────────────────────────────────────────────

model CommunityReport {
  id             String                @id @default(cuid())
  creatorId      String
  reporterId     String
  reportedUserId String
  reason         CommunityReportReason
  details        String?
  status         CommunityReportStatus @default(PENDING)
  reviewedBy     String?
  reviewedAt     DateTime?
  action         String? // "warned", "muted", "banned", "dismissed"
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([creatorId, status])
  @@index([reportedUserId])
  @@index([creatorId, createdAt])
  @@map("community_reports")
}

// ── Phase 8: Follower Journey ───────────────────────────────────────────────────

model FollowerJourney {
  id                String       @id @default(cuid())
  creatorId         String
  userId            String
  currentStage      JourneyStage @default(DISCOVERED)
  stageHistory      Json // [{ stage, enteredAt, metadata }]
  discoverySource   String? // "search", "explore", "recommendation", "share", "direct"
  firstFollowAt     DateTime?
  firstEngagementAt DateTime?
  becameLoyalAt     DateTime?
  subscribedAt      DateTime?
  becameAdvocateAt  DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([creatorId, userId])
  @@index([creatorId, currentStage])
