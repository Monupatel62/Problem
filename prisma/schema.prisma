  @@index([postId])
  @@index([uploaderId, createdAt])
  @@map("wp_media")
}

model WPDraft {
  id         String       @id @default(cuid())
  authorId   String
  postType   WPPostType   @default(TEXT_WP)
  content    String?
  mediaUrls  String[]     @default([])
