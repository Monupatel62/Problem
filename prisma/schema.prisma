// WoHoPlay Phase 8: Events & Gatherings Platform
// ═══════════════════════════════════════════════════════════════════════════════

enum WPEventType {
  PUBLIC_EVENT
  PRIVATE_EVENT
  COMMUNITY_EVENT
  CREATOR_EVENT
  BUSINESS_EVENT
  WEBINAR
  WORKSHOP
  CONFERENCE
  MEETUP
  EDUCATIONAL_EVENT
}

enum WPEventStatus {
  DRAFT
  PUBLISHED
  LIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum WPEventVisibility {
  PUBLIC
  FRIENDS
  FOLLOWERS
  GROUP_MEMBERS
  INVITE_ONLY
}

enum WPEventRSVPStatus {
  GOING
  INTERESTED
  NOT_GOING
  WAITLISTED
}

enum WPEventTicketType {
  FREE
  PAID
  VIP
  EARLY_BIRD
}

enum WPEventDiscussionType {
  POST
  QUESTION
  ANNOUNCEMENT
  PHOTO
}

enum WPEventAuditAction {
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_PUBLISHED
  EVENT_CANCELLED
  EVENT_ARCHIVED
  EVENT_DELETED
  RSVP_ADDED
  RSVP_CANCELLED
  INVITE_SENT
  INVITE_ACCEPTED
  INVITE_DECLINED
  TICKET_CREATED
  TICKET_PURCHASED
  ATTENDEE_CHECKED_IN
  ATTENDEE_REMOVED
  CAPACITY_UPDATED
  DISCUSSION_CREATED
  ANNOUNCEMENT_CREATED
  EVENT_REPORTED
  SETTINGS_UPDATED
}

// ─── Event ──────────────────────────────────────────────────────────────────────
model WPEvent {
  id              String           @id @default(dbgenerated("gen_random_uuid()::text"))
  title           String
  slug            String           @unique
  description     String?
  coverImage      String?
  category        String           @default("general")
  type            WPEventType      @default(PUBLIC_EVENT)
  status          WPEventStatus    @default(DRAFT)
  visibility      WPEventVisibility @default(PUBLIC)
  startDate       DateTime
  endDate         DateTime
  timezone        String           @default("UTC")
  location        Json?            @default("{}")
  isVirtual       Boolean          @default(false)
  virtualUrl      String?
  capacity        Int?
  attendeeCount   Int              @default(0)
  interestedCount Int              @default(0)
  waitlistEnabled Boolean          @default(false)
  requireApproval Boolean          @default(false)
  allowGuests     Boolean          @default(true)
  maxGuestsPerRSVP Int             @default(1)
  tags            String[]         @default([])
  settings        Json?            @default("{}")
  metadata        Json?            @default("{}")
  organizerId     String
  groupId         String?
  recurringRule   Json?
  parentEventId   String?
  isFeatured      Boolean          @default(false)
  viewCount       Int              @default(0)
  shareCount      Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishedAt     DateTime?
  cancelledAt     DateTime?

  organizer       User               @relation("UserEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  rsvps           WPEventRSVP[]
  invites         WPEventInvite[]
  discussions     WPEventDiscussion[]
  announcements   WPEventAnnouncement[]
  tickets         WPEventTicket[]
  analytics       WPEventAnalytics[]
  checkins        WPEventCheckin[]
  notifications   WPEventNotification[]
  auditLogs       WPEventAuditLog[]

  @@index([organizerId])
  @@index([status])
  @@index([type])
  @@index([startDate])
  @@index([createdAt(sort: Desc)])
  @@map("wp_events")
}

// ─── Event RSVP ─────────────────────────────────────────────────────────────────
model WPEventRSVP {
  id         String          @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId    String
  userId     String
  status     WPEventRSVPStatus @default(GOING)
  guestCount Int             @default(0)
  notes      String?
  metadata   Json?           @default("{}")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  event      WPEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User            @relation("UserEventRSVPs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@map("wp_event_rsvps")
}

// ─── Event Invite ───────────────────────────────────────────────────────────────
model WPEventInvite {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId    String
  senderId   String
  receiverId String
  status     String   @default("PENDING")
  message    String?
  respondedAt DateTime?
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now())

  event      WPEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender     User     @relation("UserEventInvitesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("UserEventInvitesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([eventId, receiverId])
  @@index([eventId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("wp_event_invites")
}

// ─── Event Discussion ───────────────────────────────────────────────────────────
model WPEventDiscussion {
  id        String                @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId   String
  userId    String
  type      WPEventDiscussionType @default(POST)
  content   String
  images    String[]              @default([])
  isPinned  Boolean               @default(false)
  likeCount Int                   @default(0)
  replyCount Int                  @default(0)
  parentId  String?
  metadata  Json?                 @default("{}")
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  event     WPEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation("UserEventDiscussions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@map("wp_event_discussions")
}

// ─── Event Announcement ─────────────────────────────────────────────────────────
model WPEventAnnouncement {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId   String
  title     String
  content   String
  isPinned  Boolean  @default(false)
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())

  event     WPEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([createdAt(sort: Desc)])
  @@map("wp_event_announcements")
}

// ─── Event Ticket ───────────────────────────────────────────────────────────────
model WPEventTicket {
  id          String          @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId     String
  userId      String
  type        WPEventTicketType @default(FREE)
  ticketCode  String          @unique
  price       Float           @default(0)
  currency    String          @default("INR")
  status      String          @default("ACTIVE")
  purchasedAt DateTime        @default(now())
  checkedInAt DateTime?
  metadata    Json?           @default("{}")
  createdAt   DateTime        @default(now())

  event       WPEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User            @relation("UserEventTickets", fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@index([ticketCode])
  @@index([status])
  @@map("wp_event_tickets")
}

// ─── Event Analytics ────────────────────────────────────────────────────────────
model WPEventAnalytics {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId    String
  userId     String?
  eventType  String
  source     String?
  deviceType String?
  referrer   String?
  sessionId  String?
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now())

  event      WPEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@index([eventType])
  @@index([createdAt(sort: Desc)])
  @@map("wp_event_analytics")
}

// ─── Event Checkin ──────────────────────────────────────────────────────────────
model WPEventCheckin {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId     String
  userId      String
  ticketId    String?
  checkedInAt DateTime @default(now())
  checkedInBy String?
  method      String   @default("MANUAL")
  location    Json?
  metadata    Json?    @default("{}")

  event       WPEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation("UserEventCheckins", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("wp_event_checkins")
}

// ─── Event Notification ─────────────────────────────────────────────────────────
model WPEventNotification {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId    String
  userId     String
  type       String
  title      String
  content    String?
  isRead     Boolean  @default(false)
  readAt     DateTime?
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now())

  event      WPEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User     @relation("UserEventNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("wp_event_notifications")
}

// ─── Event Audit Log ────────────────────────────────────────────────────────────
model WPEventAuditLog {
  id         String            @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId    String
  userId     String
  action     WPEventAuditAction
  targetId   String?
  targetType String?
  details    Json?             @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime          @default(now())

  event      WPEvent           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User              @relation("UserEventAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("wp_event_audit_logs")
}

