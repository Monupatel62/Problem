  @@index([creatorId, eventType, createdAt])
  @@index([contentId, eventType])
  @@index([creatorId, createdAt])
  @@index([userId, createdAt])
  @@map("p9_analytics_events")
}

model ContentAnalytics {
  id             String    @id @default(cuid())
  creatorId      String
  contentId      String
  contentType    String
  reach          Int       @default(0)
  impressions    Int       @default(0)
  views          Int       @default(0)
  uniqueViews    Int       @default(0)
  likes          Int       @default(0)
  comments       Int       @default(0)
  shares         Int       @default(0)
  saves          Int       @default(0)
  clicks         Int       @default(0)
  ctr            Float     @default(0)
  avgWatchTime   Float     @default(0)
  completionRate Float     @default(0)
  engagementRate Float     @default(0)
  viralityScore  Float     @default(0)
  trafficSources Json? // { home: n, explore: n, search: n, ... }
  peakViewsAt    DateTime?
  publishedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([creatorId, contentId])
  @@index([creatorId, contentType, updatedAt])
  @@index([creatorId, engagementRate])
  @@index([creatorId, viralityScore])
  @@map("content_analytics")
}

model RetentionAnalytics {
  id                String          @id @default(cuid())
  creatorId         String
  period            AnalyticsPeriod
  date              DateTime
  contentType       String? // null = overall
  videoRetention    Json? // [{ timestamp, percentage }]
  storyCompletion   Float           @default(0)
  reelCompletion    Float           @default(0)
  audienceRetention Float           @default(0)
  returningUsers    Int             @default(0)
  newUsers          Int             @default(0)
  churned           Int             @default(0)
  retained          Int             @default(0)
  createdAt         DateTime        @default(now())

  @@unique([creatorId, period, date, contentType])
  @@index([creatorId, period, date])
  @@map("retention_analytics")
}

model TrafficAnalytics {
  id           String          @id @default(cuid())
  creatorId    String
  period       AnalyticsPeriod
  date         DateTime
  homeFeed     Int             @default(0)
  explore      Int             @default(0)
  search       Int             @default(0)
  hashtag      Int             @default(0)
  profile      Int             @default(0)
  external     Int             @default(0)
  direct       Int             @default(0)
  notification Int             @default(0)
  email        Int             @default(0)
  total        Int             @default(0)
  topReferrers Json? // [{ url, count }]
  createdAt    DateTime        @default(now())

  @@unique([creatorId, period, date])
  @@index([creatorId, period, date])
  @@map("traffic_analytics")
}

model GrowthAnalytics {
  id                 String          @id @default(cuid())
  creatorId          String
  period             AnalyticsPeriod
  date               DateTime
  followersGained    Int             @default(0)
  followersLost      Int             @default(0)
  netGrowth          Int             @default(0)
  growthRate         Float           @default(0)
  totalFollowers     Int             @default(0)
  reachVelocity      Float           @default(0)
  engagementVelocity Float           @default(0)
  followerVelocity   Float           @default(0)
  viralityScore      Float           @default(0)
  predictedGrowth    Float?
  createdAt          DateTime        @default(now())

  @@unique([creatorId, period, date])
  @@index([creatorId, period, date])
  @@map("growth_analytics")
}

model AnalyticsReport {
  id             String          @id @default(cuid())
  creatorId      String
  title          String
  description    String?
  format         ReportFormat
  schedule       ReportSchedule?
  dateRange      Json // { start, end }
  sections       Json? // which sections to include
  fileUrl        String?
  fileSize       Int?
  status         String          @default("pending") // "pending", "generating", "ready", "failed"
  generatedAt    DateTime?
  scheduledAt    DateTime?
  isRecurring    Boolean         @default(false)
  cronExpression String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([creatorId, status])
  @@index([creatorId, isRecurring])
  @@map("analytics_reports")
}

model AnalyticsAlert {
  id          String        @id @default(cuid())
  creatorId   String
  type        AlertType
  severity    AlertSeverity @default(INFO)
  title       String
  message     String
  metadata    Json?
  isRead      Boolean       @default(false)
  isDismissed Boolean       @default(false)
  triggeredAt DateTime      @default(now())
  readAt      DateTime?

  @@index([creatorId, isRead, triggeredAt])
  @@index([creatorId, type])
  @@map("analytics_alerts")
}

model RealTimeAnalytics {
  id              String   @id @default(cuid())
  creatorId       String
  timestamp       DateTime @default(now())
  currentViewers  Int      @default(0)
  activeUsers     Int      @default(0)
  currentReach    Int      @default(0)
  liveEngagement  Int      @default(0)
  eventsPerMinute Int      @default(0)
  topContent      Json? // [{ contentId, views }]
  metadata        Json?

  @@index([creatorId, timestamp])
  @@map("realtime_analytics")
}

model FunnelAnalytics {
  id                       String          @id @default(cuid())
  creatorId                String
  period                   AnalyticsPeriod
  date                     DateTime
  discovery                Int             @default(0)
  views                    Int             @default(0)
  engagement               Int             @default(0)
  follows                  Int             @default(0)
  subscribers              Int             @default(0)
  customers                Int             @default(0)
  discoveryToViewRate      Float           @default(0)
  viewToEngagementRate     Float           @default(0)
  engagementToFollowRate   Float           @default(0)
  followToSubscriberRate   Float           @default(0)
  subscriberToCustomerRate Float           @default(0)
  createdAt                DateTime        @default(now())

  @@unique([creatorId, period, date])
  @@index([creatorId, period, date])
  @@map("funnel_analytics")
}

// ── Phase 10: Monetization & Creator Revenue ─────────────────────────────────

enum MonetizationStatus {
