  updatedAt        DateTime        @default(now()) @updatedAt

  @@unique([query, date, domain])
  @@index([query])
  @@index([domain])
  @@index([date(sort: Desc)])
  @@index([noResultFlag])
  @@index([clickThroughRate(sort: Desc)])
  @@map("wp_search_analytics")
}

// ─── Search Suggestions ─────────────────────────────────────────────────────────
model WPSearchSuggestion {
