  id         String          @id @default(dbgenerated("gen_random_uuid()::text"))
  userId     String
  type       WPAIRequestType @default(CHAT)
  provider   WPAIProvider    @default(WOHO_AI)
  modelId    String?
  prompt     String
  context    Json?           @default("{}")
  status     WPAIStatus      @default(PENDING)
  responseId String?
  tokens     Int             @default(0)
  cost       Float           @default(0.0)
  latency    Int             @default(0)
  metadata   Json?           @default("{}")
  createdAt  DateTime        @default(now())

  user     User          @relation("UserAIRequests", fields: [userId], references: [id], onDelete: Cascade)
  model    WPAIModel?    @relation("ModelAIRequests", fields: [modelId], references: [id], onDelete: SetNull)
  response WPAIResponse? @relation("RequestAIResponse")

  @@index([userId])
  @@index([type])
  @@index([provider])
  @@index([status])
  @@index([modelId])
  @@index([createdAt(sort: Desc)])
  @@map("wp_ai_requests")
}

