enum BrandVerification {
  PENDING
  VERIFIED_BRAND
  VERIFIED_AGENCY
  ENTERPRISE_PARTNER
}

enum CampaignStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CampaignType {
  SPONSORED_POST
  SPONSORED_REEL
  SPONSORED_VIDEO
  SPONSORED_STORY
  SPONSORED_LIVE
  PRODUCT_REVIEW
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTER_OFFERED
  WITHDRAWN
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  TERMINATED
  DISPUTED
}

