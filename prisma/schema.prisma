model BrandProfile {
  id             String            @id @default(cuid())
  userId         String            @unique
  companyName    String
  description    String?
  website        String?
  industry       String?
  categories     String[]          @default([])
  logo           String?
  coverImage     String?
  socialProfiles Json?
  contactEmail   String?
  contactPhone   String?
  verification   BrandVerification @default(PENDING)
  isAgency       Boolean           @default(false)
  verifiedAt     DateTime?
  totalCampaigns Int               @default(0)
  totalSpent     Float             @default(0)
  rating         Float             @default(0)
  reviewCount    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  campaigns      BrandCampaign[]
  collaborations Collaboration[]
  brandReviews   BrandReview[]
  creatorReviews CreatorReview[]
  agencyProfile  AgencyProfile?

  @@index([verification])
  @@index([industry])
  @@index([rating])
  @@map("brand_profiles")
}

model AgencyProfile {
  id              String       @id @default(cuid())
  brandProfileId  String       @unique
  brandProfile    BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  agencyName      String
  agencySize      String       @default("small")
  managedBrands   Int          @default(0)
  managedCreators Int          @default(0)
  specializations String[]     @default([])
  commissionRate  Float        @default(0.10)
  website         String?
  contactPerson   String?
  contactEmail    String?
  verified        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([verified])
  @@map("agency_profiles")
}

model BrandCampaign {
  id                  String         @id @default(cuid())
  brandId             String
  brand               BrandProfile   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  campaignType        CampaignType
  status              CampaignStatus @default(DRAFT)
  budget              Float
  currency            String         @default("INR")
  minBudget           Float?
  maxBudget           Float?
  requirements        Json?
  deliverables        Json?
  startDate           DateTime?
  endDate             DateTime?
  applicationDeadline DateTime?
  maxCreators         Int            @default(1)
  acceptedCreators    Int            @default(0)
  applicantCount      Int            @default(0)
  tags                String[]       @default([])
  isPublic            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  collaborations Collaboration[]

  @@index([brandId, status])
  @@index([status, isPublic])
  @@index([campaignType, status])
  @@map("brand_campaigns")
}

model Collaboration {
  id           String              @id @default(cuid())
  campaignId   String
  campaign     BrandCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId    String
  brandId      String
  brand        BrandProfile        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  status       CollaborationStatus @default(APPLIED)
  appliedAt    DateTime            @default(now())
  invitedAt    DateTime?
  acceptedAt   DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  notes        String?
  creatorPitch String?
  totalEarned  Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  proposals      CollabProposal[]
  contract       CollaborationContract?
  deliverables   CollabDeliverable[]
  payments       CampaignPayment[]
  messages       CampaignMessage[]
  analytics      CollaborationAnalytics?
  brandReviews   BrandReview[]
  creatorReviews CreatorReview[]

  @@unique([campaignId, creatorId])
  @@index([creatorId, status])
  @@index([brandId, status])
  @@index([campaignId])
  @@map("collaborations")
}

model CollabProposal {
  id              String         @id @default(cuid())
  collaborationId String
  collaboration   Collaboration  @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  senderId        String
  senderType      String         @default("creator")
  amount          Float
  currency        String         @default("INR")
  message         String?
  deliverables    Json?
  timeline        Json?
  status          ProposalStatus @default(PENDING)
  counterAmount   Float?
  counterMessage  String?
  respondedAt     DateTime?
  createdAt       DateTime       @default(now())

  @@index([collaborationId, status])
  @@index([senderId])
  @@map("collab_proposals")
}

model CollaborationContract {
  id                String         @id @default(cuid())
  collaborationId   String         @unique
  collaboration     Collaboration  @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  brandId           String
  creatorId         String
  title             String
  terms             Json
  totalAmount       Float
  currency          String         @default("INR")
  milestones        Json?
  status            ContractStatus @default(DRAFT)
  signedByBrand     Boolean        @default(false)
  signedByCreator   Boolean        @default(false)
  signedAt          DateTime?
  completedAt       DateTime?
  terminatedAt      DateTime?
  terminationReason String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  deliverables CollabDeliverable[]
  payments     CampaignPayment[]

  @@index([brandId, status])
  @@index([creatorId, status])
  @@map("collaboration_contracts")
}

model CollabDeliverable {
  id              String                 @id @default(cuid())
  collaborationId String
  collaboration   Collaboration          @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  contractId      String?
  contract        CollaborationContract? @relation(fields: [contractId], references: [id])
  title           String
  description     String?
  contentType     String
  contentId       String?
  deadline        DateTime
  status          DeliverableStatus      @default(PENDING)
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  revisionCount   Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([collaborationId, status])
  @@index([deadline])
  @@map("collab_deliverables")
}

model CampaignPayment {
  id              String                 @id @default(cuid())
  collaborationId String
  collaboration   Collaboration          @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  contractId      String?
  contract        CollaborationContract? @relation(fields: [contractId], references: [id])
  brandId         String
  creatorId       String
  amount          Float
  fee             Float                  @default(0)
  net             Float
  currency        String                 @default("INR")
  milestone       String?
  status          String                 @default("pending")
  paymentRef      String?
  heldAt          DateTime?
  releasedAt      DateTime?
  createdAt       DateTime               @default(now())

  @@index([collaborationId])
  @@index([creatorId, status])
  @@index([brandId, createdAt])
  @@map("campaign_payments")
}

model CampaignMessage {
  id              String        @id @default(cuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  senderId        String
  senderType      String        @default("creator")
  content         String
  attachments     Json?
  isRead          Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@index([collaborationId, createdAt])
  @@index([collaborationId, isRead])
  @@map("campaign_messages")
}

model BrandReview {
  id              String         @id @default(cuid())
  brandId         String
  brand           BrandProfile   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creatorId       String
  collaborationId String?
  collaboration   Collaboration? @relation(fields: [collaborationId], references: [id])
  rating          Int
  comment         String?
  createdAt       DateTime       @default(now())

  @@unique([brandId, creatorId, collaborationId])
  @@index([brandId, rating])
  @@map("brand_reviews")
}

model CreatorReview {
  id              String         @id @default(cuid())
  creatorId       String
  brandId         String
  brand           BrandProfile   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  collaborationId String?
  collaboration   Collaboration? @relation(fields: [collaborationId], references: [id])
  rating          Int
  comment         String?
  createdAt       DateTime       @default(now())

  @@unique([creatorId, brandId, collaborationId])
  @@index([creatorId, rating])
  @@map("creator_reviews")
}

model CollaborationAnalytics {
  id              String        @id @default(cuid())
  collaborationId String        @unique
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  reach           Int           @default(0)
  impressions     Int           @default(0)
  engagement      Int           @default(0)
  clicks          Int           @default(0)
  conversions     Int           @default(0)
  engagementRate  Float         @default(0)
  roi             Float         @default(0)
  updatedAt       DateTime      @updatedAt

  @@map("collaboration_analytics")
}

model BrandFraudFlag {
  id          String    @id @default(cuid())
