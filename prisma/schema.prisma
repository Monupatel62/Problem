// ─── Enums ──────────────────────────────────────────────────────────────────────

enum WPLiveStreamType {
  CREATOR
  PERSONAL
  GAMING
  BUSINESS
  EDUCATIONAL
  EVENT
  SHOPPING
  AUDIO
}

enum WPLiveStreamStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  ARCHIVED
}

enum WPLiveVisibility {
  PUBLIC
  PRIVATE
  FOLLOWERS
  SUBSCRIBERS
  INVITE_ONLY
}

enum WPLiveChatMode {
  NORMAL
  SLOW
  SUBSCRIBER_ONLY
  FOLLOWER_ONLY
  DISABLED
}

enum WPLiveGuestRole {
  HOST
  COHOST
  GUEST
  PRODUCER
}

enum WPLiveGiftType {
  VIRTUAL_GIFT
  TIP
  STAR
  SUPER_CHAT
}

enum WPLiveModerationAction {
  MUTE
  TIMEOUT
  BAN
  REMOVE
  WARN
}

enum WPLiveQuality {
  Q_240P
  Q_360P
  Q_480P
  Q_720P
  Q_1080P
  Q_1440P
  Q_4K
}

enum WPLiveAuditAction {
  STREAM_CREATED
  STREAM_STARTED
  STREAM_ENDED
  STREAM_CANCELLED
  STREAM_ARCHIVED
  STREAM_UPDATED
  GUEST_INVITED
  GUEST_REMOVED
  GUEST_JOINED
  GUEST_LEFT
  VIEWER_JOINED
  VIEWER_LEFT
  CHAT_MESSAGE_SENT
  CHAT_MESSAGE_DELETED
  CHAT_MESSAGE_PINNED
  MODERATION_MUTE
  MODERATION_TIMEOUT
  MODERATION_BAN
  MODERATION_REMOVE
  MODERATION_WARN
  GIFT_SENT
  GIFT_RECEIVED
  PRODUCT_ADDED
  PRODUCT_REMOVED
  PRODUCT_PINNED
  RECORDING_STARTED
  RECORDING_STOPPED
  RECORDING_PROCESSED
  MONETIZATION_ENABLED
  SETTINGS_CHANGED
  KEY_REGENERATED
}

// ─── Live Stream ────────────────────────────────────────────────────────────────

model WPLiveStream {
  id              String             @id @default(dbgenerated("gen_random_uuid()::text"))
  title           String
  description     String?
  thumbnailUrl    String?
  streamKey       String             @unique
  backupStreamKey String?
  type            WPLiveStreamType   @default(CREATOR)
  status          WPLiveStreamStatus @default(SCHEDULED)
  visibility      WPLiveVisibility   @default(PUBLIC)
  chatMode        WPLiveChatMode     @default(NORMAL)
  hostId          String
  channelId       String?
  category        String?
  tags            String[]           @default([])
  isRecording     Boolean            @default(false)
  recordingUrl    String?
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  duration        Int                @default(0)
  peakViewers     Int                @default(0)
  totalViewers    Int                @default(0)
  currentViewers  Int                @default(0)
  likeCount       Int                @default(0)
  chatCount       Int                @default(0)
  giftRevenue     Float              @default(0.0)
  isMonetized     Boolean            @default(false)
  ticketPrice     Float?
  qualities       Json?              @default("[]")
  ingestUrl       String?
  playbackUrl     String?
  hlsUrl          String?
  orientation     String             @default("LANDSCAPE")
  metadata        Json?              @default("{}")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  host       User               @relation("UserLiveStreams", fields: [hostId], references: [id], onDelete: Cascade)
  sessions   WPLiveSession[]
  viewers    WPLiveViewer[]
  chatMessages WPLiveChatMessage[]
  reactions  WPLiveReaction[]
  gifts      WPLiveGift[]
  analytics  WPLiveAnalytics[]
  moderation WPLiveModeration[]
  products   WPLiveProduct[]
  recordings WPLiveRecording[]
  guests     WPLiveGuest[]
  auditLogs  WPLiveAuditLog[]

  @@index([hostId])
  @@index([status])
  @@index([type])
  @@index([visibility])
  @@index([category])
  @@index([scheduledAt])
  @@index([startedAt])
  @@index([currentViewers(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("wp_live_streams")
}

// ─── Live Session ───────────────────────────────────────────────────────────────

model WPLiveSession {
  id            String       @id @default(dbgenerated("gen_random_uuid()::text"))
  streamId      String
  sessionNumber Int          @default(1)
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  duration      Int          @default(0)
  peakViewers   Int          @default(0)
  totalViewers  Int          @default(0)
  avgViewers    Int          @default(0)
  quality       WPLiveQuality @default(Q_720P)
  bitrate       Int?
  fps           Int?
  metadata      Json?        @default("{}")
  createdAt     DateTime     @default(now())

  stream WPLiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([startedAt(sort: Desc)])
  @@map("wp_live_sessions")
}

// ─── Live Viewer ────────────────────────────────────────────────────────────────

model WPLiveViewer {
  id            String   @id @default(dbgenerated("gen_random_uuid()::text"))
  streamId      String
  userId        String
  joinedAt      DateTime @default(now())
  leftAt        DateTime?
  watchDuration Int      @default(0)
  isActive      Boolean  @default(true)
  deviceType    String?
  location      String?
  metadata      Json?    @default("{}")
  createdAt     DateTime @default(now())

  stream WPLiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User         @relation("UserLiveViewers", fields: [userId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([userId])
  @@index([isActive])
  @@index([streamId, userId])
  @@index([joinedAt(sort: Desc)])
  @@map("wp_live_viewers")
}

// ─── Live Chat Message ──────────────────────────────────────────────────────────

model WPLiveChatMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()::text"))
  streamId       String
  userId         String
  content        String
  replyToId      String?
  isPinned       Boolean  @default(false)
  isModeratorMsg Boolean  @default(false)
  isDeleted      Boolean  @default(false)
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now())

  stream WPLiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User         @relation("UserLiveChatMessages", fields: [userId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([userId])
  @@index([isPinned])
  @@index([createdAt(sort: Desc)])
  @@map("wp_live_chat_messages")
}

// ─── Live Reaction ──────────────────────────────────────────────────────────────

model WPLiveReaction {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  streamId  String
  userId    String
  emoji     String
  count     Int      @default(1)
  createdAt DateTime @default(now())

  stream WPLiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User         @relation("UserLiveReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("wp_live_reactions")
}

// ─── Live Gift ──────────────────────────────────────────────────────────────────

model WPLiveGift {
  id           String         @id @default(dbgenerated("gen_random_uuid()::text"))
  streamId     String
  senderId     String
  recipientId  String
  giftType     WPLiveGiftType @default(VIRTUAL_GIFT)
  giftName     String
  amount       Float          @default(0.0)
  currency     String         @default("USD")
  animationUrl String?
  message      String?
  metadata     Json?          @default("{}")
  createdAt    DateTime       @default(now())

  stream    WPLiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  sender    User         @relation("UserLiveGifts", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([senderId])
  @@index([recipientId])
  @@index([giftType])
  @@index([createdAt(sort: Desc)])
  @@map("wp_live_gifts")
}

// ─── Live Analytics ─────────────────────────────────────────────────────────────

model WPLiveAnalytics {
  id                String   @id @default(dbgenerated("gen_random_uuid()::text"))
  streamId          String
  timestamp         DateTime @default(now())
  viewerCount       Int      @default(0)
