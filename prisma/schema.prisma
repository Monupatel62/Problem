// ─── Search Index ───────────────────────────────────────────────────────────────
model WPSearchIndex {
  id           String         @id @default(dbgenerated("gen_random_uuid()::text"))
  entityId     String
  entityType   WPSearchDomain
  title        String
  description  String?
  tags         String[]       @default([])
  category     String?
  location     Json?          @default("{}")
  metadata     Json?          @default("{}")
  embedding    Json?
  popularity   Float          @default(0.0)
  freshness    DateTime       @default(now())
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt

  @@unique([entityId, entityType])
  @@index([entityId])
  @@index([entityType])
  @@index([category])
  @@index([popularity(sort: Desc)])
  @@index([freshness(sort: Desc)])
  @@index([isActive])
  @@map("wp_search_index")
}

// ─── Search History ─────────────────────────────────────────────────────────────
model WPSearchHistory {
  id               String          @id @default(dbgenerated("gen_random_uuid()::text"))
  userId           String
  query            String
  domain           WPSearchDomain?
  resultType       WPSearchResultType?
  resultCount      Int             @default(0)
  clickedEntityId  String?
  clickedEntityType WPSearchDomain?
  filters          Json?           @default("{}")
  responseTime     Int?            @default(0)
  timestamp        DateTime        @default(now())

  user User @relation("UserSearchHistory", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([query])
  @@index([domain])
  @@index([timestamp(sort: Desc)])
  @@index([userId, timestamp(sort: Desc)])
  @@map("wp_search_history")
}

// ─── Trending Queries ───────────────────────────────────────────────────────────
model WPTrendingQuery {
  id             String          @id @default(dbgenerated("gen_random_uuid()::text"))
  query          String
  domain         WPSearchDomain?
  searchCount    Int             @default(1)
  trendingScore  Float           @default(0.0)
  window         WPTrendingWindow @default(HOURS_24)
  region         String?
  category       String?
  hashtags       String[]        @default([])
  relatedQueries String[]        @default([])
  detectedAt     DateTime        @default(now())
  expiresAt      DateTime?
  isActive       Boolean         @default(true)

  @@index([query])
  @@index([domain])
  @@index([window])
  @@index([trendingScore(sort: Desc)])
  @@index([region])
  @@index([detectedAt(sort: Desc)])
  @@index([isActive])
  @@map("wp_trending_queries")
}

// ─── Recommendation Entry ───────────────────────────────────────────────────────
model WPRecommendationEntry {
  id              String               @id @default(dbgenerated("gen_random_uuid()::text"))
  userId          String
  entityId        String
  entityType      WPRecommendationType
