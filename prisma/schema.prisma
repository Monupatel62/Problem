enum WorkspaceStatus {
  ACTIVE_WS
  ARCHIVED_WS
  SUSPENDED_WS
}

enum TaskStatus {
  TODO
  IN_PROGRESS_TASK
  IN_REVIEW_TASK
  DONE
  CANCELLED_TASK
}

enum TaskPriority {
  LOW_P
  MEDIUM_P
  HIGH_P
  URGENT_P
}

enum ProjectStatus {
  PLANNING
  ACTIVE_PROJECT
  ON_HOLD
  COMPLETED_PROJECT
  CANCELLED_PROJECT
}

enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED_WF
  REJECTED_WF
  REVISION_REQUESTED_WF
}

enum SubscriptionPlan {
  FREE_PLAN
  STARTER_PLAN
  PRO_PLAN
  BUSINESS_PLAN
  ENTERPRISE_PLAN
}

model Organization {
  id            String           @id @default(cuid())
  ownerId       String
  name          String
  slug          String           @unique
  orgType       OrgType          @default(CREATOR_TEAM)
  description   String?
  logoUrl       String?
  website       String?
  industry      String?
  size          String           @default("1-10")
  plan          SubscriptionPlan @default(FREE_PLAN)
  maxMembers    Int              @default(5)
  maxWorkspaces Int              @default(3)
  isVerified    Boolean          @default(false)
  settings      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  workspaces OrgWorkspace[]
  teams      OrgTeam[]
  members    OrgMember[]
  tasks      OrgTask[]
  projects   OrgProject[]
  documents  OrgDocument[]
  approvals  ApprovalWorkflow[]

  @@index([ownerId])
  @@map("organizations")
}

model OrgWorkspace {
  id          String          @id @default(cuid())
  orgId       String
  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  icon        String?
  color       String          @default("#7c3aed")
  status      WorkspaceStatus @default(ACTIVE_WS)
  settings    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([orgId, slug])
  @@index([orgId, status])
  @@map("workspaces")
}

model OrgTeam {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  department  String?
  leadId      String?
  memberCount Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members OrgMember[]

  @@index([orgId])
  @@map("teams")
}

model OrgMember {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String
  teamId     String?
  team       OrgTeam?     @relation(fields: [teamId], references: [id])
  role       MemberRole   @default(VIEWER_ROLE)
  title      String?
  department String?
  isActive   Boolean      @default(true)
  joinedAt   DateTime     @default(now())
  invitedBy  String?

  @@unique([orgId, userId])
  @@index([orgId, isActive])
  @@index([userId])
  @@map("org_members")
}

model ApprovalWorkflow {
  id            String         @id @default(cuid())
  orgId         String
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contentId     String
  contentType   String
  title         String
  submittedBy   String
  assignedTo    String?
  status        ApprovalStatus @default(PENDING_APPROVAL)
  revisionNotes String?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([orgId, status])
  @@index([assignedTo, status])
  @@map("approval_workflows")
}

model OrgTask {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId   String?
  title       String
  description String?
  assignedTo  String?
  createdBy   String
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM_P)
  dueDate     DateTime?
  completedAt DateTime?
  tags        String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId, status])
  @@index([assignedTo, status])
  @@map("org_tasks")
}

model OrgProject {
  id          String        @id @default(cuid())
  orgId       String
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  leadId      String?
  startDate   DateTime?
  endDate     DateTime?
  progress    Int           @default(0)
  budget      Float?
  tags        String[]      @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orgId, status])
  @@map("org_projects")
}

model OrgDocument {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadedBy  String
  title       String
  fileUrl     String
  fileType    String?
  fileSize    Int          @default(0)
  folder      String       @default("/")
  accessLevel String       @default("team")
  tags        String[]     @default([])
  createdAt   DateTime     @default(now())

  @@index([orgId, folder])
  @@map("org_documents")
}

// ── Phase 16: Ads Manager & Advertising Ecosystem ────────────────────────

enum CampaignObjective {
  AWARENESS
  REACH
  TRAFFIC
  ENGAGEMENT
  FOLLOWERS
  VIDEO_VIEWS
  LEAD_GENERATION
  CONVERSIONS_OBJ
}

enum AdStatus {
  DRAFT_AD
  PENDING_REVIEW_AD
  ACTIVE_AD
  PAUSED_AD
  COMPLETED_AD
  REJECTED_AD
  ARCHIVED_AD
}

enum AdType {
  IMAGE_AD
  VIDEO_AD
  REEL_AD
  STORY_AD
  CAROUSEL_AD
  LEAD_AD
}

enum BiddingStrategy {
  AUTOMATIC_BID
  MANUAL_CPC
  MANUAL_CPM
  TARGET_CPA
}

enum BudgetType {
  DAILY_BUDGET
  LIFETIME_BUDGET
}

enum ConversionEventType {
  PAGE_VIEW_EV
  ADD_TO_CART_EV
  PURCHASE_EV
  REGISTRATION_EV
  LEAD_EV
  DOWNLOAD_EV
  CLICK_EV
  VIEW_EV
}

model AdAccount {
  id            String   @id @default(cuid())
  ownerId       String
  name          String
  businessName  String?
  status        String   @default("active")
  currency      String   @default("INR")
  timezone      String   @default("Asia/Kolkata")
  spendingLimit Float?
  totalSpent    Float    @default(0)
  isBusiness    Boolean  @default(false)
  paymentMethod Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns AdCampaign[]
  audiences AdAudience[]

  @@index([ownerId])
  @@map("ad_accounts")
}

model AdCampaign {
  id           String            @id @default(cuid())
  accountId    String
  account      AdAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  objective    CampaignObjective
  status       AdStatus          @default(DRAFT_AD)
  budgetType   BudgetType        @default(DAILY_BUDGET)
  budgetAmount Float
  spent        Float             @default(0)
  startDate    DateTime?
  endDate      DateTime?
  isAbTest     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  adSets AdSet[]

  @@index([accountId, status])
  @@map("ad_campaigns")
}

model AdSet {
  id            String          @id @default(cuid())
  campaignId    String
  campaign      AdCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  accountId     String
  name          String
  status        AdStatus        @default(DRAFT_AD)
  budgetAmount  Float?
  budgetType    BudgetType      @default(DAILY_BUDGET)
  bidding       BiddingStrategy @default(AUTOMATIC_BID)
  bidAmount     Float?
  placements    String[]        @default([])
  scheduleStart DateTime?
  scheduleEnd   DateTime?
  frequencyCap  Int?
  spent         Float           @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  creatives AdCreative[]

  @@index([campaignId])
  @@map("ad_sets")
}

model AdAudience {
  id             String    @id @default(cuid())
  accountId      String
  account        AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  audienceType   String    @default("custom")
  targeting      Json
  estimatedReach Int       @default(0)
  isSaved        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([accountId])
  @@map("ad_audiences")
}

model AdCreative {
  id              String   @id @default(cuid())
  adSetId         String
  adSet           AdSet    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  accountId       String
  adType          AdType
  status          AdStatus @default(DRAFT_AD)
  headline        String?
  bodyText        String?
  callToAction    String?
  mediaUrl        String?
  mediaUrls       String[] @default([])
  thumbnailUrl    String?
  landingUrl      String?
  previewUrl      String?
  reviewStatus    String   @default("pending")
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([adSetId])
  @@map("ad_creatives")
}

model ConversionEvent {
  id         String              @id @default(cuid())
  accountId  String
  campaignId String?
  adSetId    String?
  creativeId String?
  eventType  ConversionEventType
  userId     String?
  value      Float               @default(0)
  currency   String              @default("INR")
  metadata   Json?
  pixelId    String?
  createdAt  DateTime            @default(now())

  @@index([campaignId, eventType])
  @@index([accountId, createdAt])
  @@map("conversion_events")
}

// ── Phase 17: Cross-Platform Publishing & Distribution ────────────────────

enum PlatformType {
  WOHOPLAY
  WOHOSTUDIO
  BLOG_PLAT
  COMMUNITY_PLAT
  WEBSITE_PLAT
  EXTERNAL_PLAT
}

enum AccountConnectionStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED_CONN
  ERROR_CONN
}

enum PublishingStatus {
  DRAFT_PUB
  QUEUED_PUB
  SCHEDULED_PUB
  PUBLISHING_PUB
  PUBLISHED_PUB
  FAILED_PUB
  CANCELLED_PUB
}

enum ContentFormat {
  POST_FMT
  REEL_FMT
  VIDEO_FMT
  STORY_FMT
  ARTICLE_FMT
  SHORT_FMT
}

enum DistributionMode {
  ALL_PLATFORMS
  SELECTED_PLAT
  CUSTOM_SCHEDULE
  RULE_BASED_DIST
}

model ConnectedAccount {
  id           String                  @id @default(cuid())
  userId       String
  platform     PlatformType
  platformId   String?
  platformName String?
  username     String?
  avatarUrl    String?
  accessToken  String?
  refreshToken String?
  tokenExpires DateTime?
  permissions  String[]                @default([])
  status       AccountConnectionStatus @default(CONNECTED)
  lastSynced   DateTime?
  errorMessage String?
  metadata     Json?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  logs PublishingLog[]

  @@index([userId, status])
  @@index([platform, status])
  @@map("connected_accounts")
}

model PublishingJob {
  id               String           @id @default(cuid())
  userId           String
  contentId        String?
  contentType      ContentFormat
  title            String
  body             String?
  mediaUrls        String[]         @default([])
  hashtags         String[]         @default([])
  targetAccounts   String[]         @default([])
  status           PublishingStatus @default(DRAFT_PUB)
  scheduledAt      DateTime?
  publishedAt      DateTime?
  errorMessage     String?
  retryCount       Int              @default(0)
  maxRetries       Int              @default(3)
  distributionMode DistributionMode @default(ALL_PLATFORMS)
  approvalStatus   String           @default("not_required")
  approvedBy       String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  logs     PublishingLog[]
  versions PubContentVersion[]
  calendar PublishingCalendarEntry[]

  @@index([userId, status])
  @@index([scheduledAt, status])
  @@map("publishing_jobs")
}

model DistributionRule {
  id              String         @id @default(cuid())
  userId          String
  name            String
  description     String?
  contentType     ContentFormat?
  targetPlatforms String[]       @default([])
  scheduleOffset  Int            @default(0)
  transformRules  Json?
  conditions      Json?
  isActive        Boolean        @default(true)
  priority        Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, isActive])
  @@map("distribution_rules")
}

model PublishingCalendarEntry {
  id            String           @id @default(cuid())
  userId        String
  jobId         String?
  job           PublishingJob?   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title         String
  contentType   ContentFormat?
  platform      PlatformType?
  scheduledDate DateTime         @db.Date
  scheduledTime String?
  status        PublishingStatus @default(SCHEDULED_PUB)
  notes         String?
  createdAt     DateTime         @default(now())

  @@index([userId, scheduledDate])
  @@map("publishing_calendar")
}

model PublishingLog {
  id             String            @id @default(cuid())
  jobId          String?
  job            PublishingJob?    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId         String
  accountId      String?
  account        ConnectedAccount? @relation(fields: [accountId], references: [id])
  platform       PlatformType
  action         String
  status         String
  platformPostId String?
  errorMessage   String?
  responseData   Json?
  durationMs     Int               @default(0)
  createdAt      DateTime          @default(now())

  @@index([jobId])
  @@index([userId, createdAt])
  @@map("publishing_logs")
}

model PubContentVersion {
  id            String         @id @default(cuid())
  jobId         String?
  job           PublishingJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId        String
  versionNumber Int            @default(1)
  platform      PlatformType?
  title         String?
  body          String?
  mediaUrls     String[]       @default([])
  hashtags      String[]       @default([])
  metadata      Json?
  isCurrent     Boolean        @default(true)
  createdAt     DateTime       @default(now())

  @@index([jobId, isCurrent])
  @@map("pub_content_versions")
}

// ── Phase 18: Creator CRM & Relationship Management ──────────────────────

enum ContactType {
  FOLLOWER_CT
  SUBSCRIBER_CT
  CUSTOMER_CT
  SPONSOR_CT
  PARTNER_CT
  LEAD_CT
  OTHER_CT
}

enum LeadStage {
  NEW_LEAD
  CONTACTED_LEAD
  QUALIFIED_LEAD
  PROPOSAL_SENT_LEAD
  CONVERTED_LEAD
  LOST_LEAD
}

enum LeadSource {
  FORM_SRC
  MARKETPLACE_SRC
  CAMPAIGN_SRC
  REFERRAL_SRC
  MANUAL_SRC
  ORGANIC_SRC
}

enum DealStage {
  DISCOVERY_DEAL
  PROPOSAL_DEAL
  NEGOTIATION_DEAL
  CLOSED_WON
  CLOSED_LOST
}

enum CRMTaskStatus {
  PENDING_CRM
  IN_PROGRESS_CRM
  COMPLETED_CRM
  CANCELLED_CRM
}

enum LifecycleStage {
  VISITOR_LC
  FOLLOWER_LC
  LEAD_LC
  CUSTOMER_LC
  SUBSCRIBER_LC
  LOYAL_CUSTOMER_LC
}

model CRMContact {
  id             String         @id @default(cuid())
  ownerId        String
  contactType    ContactType    @default(OTHER_CT)
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  avatarUrl      String?
  company        String?
  title          String?
  location       String?
  socialProfiles Json?
  tags           String[]       @default([])
  lifecycleStage LifecycleStage @default(VISITOR_LC)
  leadScore      Int            @default(0)
  totalRevenue   Float          @default(0)
  lastActivity   DateTime?
  notes          String?
  customFields   Json?
  isArchived     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  leads      CRMLead[]
  deals      CRMDeal[]
  tasks      CRMTask[]
  crmNotes   CRMNote[]
  activities CRMActivity[]

  @@index([ownerId, isArchived])
  @@index([ownerId, contactType])
  @@index([ownerId, lifecycleStage])
  @@map("crm_contacts")
}

model CRMLead {
  id            String      @id @default(cuid())
  ownerId       String
  contactId     String?
  contact       CRMContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipelineId    String?
  source        LeadSource  @default(MANUAL_SRC)
  stage         LeadStage   @default(NEW_LEAD)
  title         String
  value         Float       @default(0)
  currency      String      @default("INR")
  assignedTo    String?
  expectedClose DateTime?
  lostReason    String?
  convertedAt   DateTime?
  notes         String?
  tags          String[]    @default([])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([ownerId, stage])
  @@index([pipelineId, stage])
  @@map("crm_leads")
}

model CRMDeal {
  id            String      @id @default(cuid())
  ownerId       String
  contactId     String?
  contact       CRMContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipelineId    String?
  title         String
  value         Float       @default(0)
  currency      String      @default("INR")
  stage         DealStage   @default(DISCOVERY_DEAL)
  probability   Int         @default(50)
  expectedClose DateTime?
  closedAt      DateTime?
  won           Boolean?
  notes         String?
  tags          String[]    @default([])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tasks    CRMTask[]
  crmNotes CRMNote[]

  @@index([ownerId, stage])
  @@map("crm_deals")
}

model CRMPipeline {
  id           String   @id @default(cuid())
  ownerId      String
  name         String
  description  String?
  pipelineType String   @default("lead")
  stages       Json
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId, isActive])
  @@map("crm_pipelines")
}

model CRMTask {
  id          String        @id @default(cuid())
  ownerId     String
  contactId   String?
  contact     CRMContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        CRMDeal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  title       String
  description String?
  taskType    String        @default("follow_up")
  status      CRMTaskStatus @default(PENDING_CRM)
  priority    String        @default("medium")
  dueDate     DateTime?
  completedAt DateTime?
  reminderAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ownerId, status])
  @@index([dueDate, status])
  @@map("crm_tasks")
}

model CRMNote {
  id          String      @id @default(cuid())
  ownerId     String
  contactId   String?
  contact     CRMContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        CRMDeal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  noteType    String      @default("note")
  content     String
  attachments Json?
  createdAt   DateTime    @default(now())

  @@index([contactId, createdAt])
  @@map("crm_notes")
}

model CRMActivity {
  id           String      @id @default(cuid())
  ownerId      String
  contactId    String?
  contact      CRMContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  activityType String
  title        String
  description  String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([contactId, createdAt])
  @@index([ownerId, createdAt])
  @@map("crm_activities")
}

// ── Phase 19: Creator Automation Platform & Workflow Engine ───────────────

enum WorkflowStatus {
  DRAFT_WF
  ACTIVE_WF
  PAUSED_WF
  ARCHIVED_WF
}

enum TriggerType {
  POST_PUBLISHED
  REEL_PUBLISHED
  VIDEO_PUBLISHED
  STORY_PUBLISHED
  NEW_FOLLOWER
  NEW_SUBSCRIBER
  NEW_CUSTOMER
  NEW_LEAD
  LEAD_CONVERTED
  DEAL_CLOSED
  NEW_PURCHASE
  NEW_SUBSCRIPTION
  NEW_TIP
  SCHEDULED_TRIG
  MANUAL_TRIGGER
  WEBHOOK_TRIG
}

enum ActionType {
  SEND_NOTIFICATION
  CREATE_TASK_ACT
  UPDATE_CRM_ACT
  ASSIGN_TAG
  PUBLISH_CONTENT_ACT
  SCHEDULE_CONTENT_ACT
  SEND_MESSAGE_ACT
  TRIGGER_AI_AGENT
  SEND_EMAIL_ACT
  ADD_TO_SEGMENT
  UPDATE_PIPELINE_ACT
  WEBHOOK_CALL
}

enum ExecutionStatus {
  QUEUED_EXEC
  RUNNING_EXEC
  COMPLETED_EXEC
  FAILED_EXEC
  SKIPPED_EXEC
  RETRYING_EXEC
}

enum ConditionOperator {
  EQUALS_OP
  NOT_EQUALS_OP
  GREATER_THAN_OP
  LESS_THAN_OP
  CONTAINS_OP
  NOT_CONTAINS_OP
  IN_LIST_OP
  NOT_IN_LIST_OP
  IS_EMPTY_OP
  IS_NOT_EMPTY_OP
}

model AutomationWorkflow {
  id            String         @id @default(cuid())
  ownerId       String
  name          String
  description   String?
  status        WorkflowStatus @default(DRAFT_WF)
  triggerConfig Json
  conditions    Json?
  actions       Json
  version       Int            @default(1)
  totalRuns     Int            @default(0)
  successCount  Int            @default(0)
  failureCount  Int            @default(0)
  lastRunAt     DateTime?
  isTemplate    Boolean        @default(false)
  templateId    String?
  tags          String[]       @default([])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  triggers   WorkflowTrigger[]
  executions WorkflowExecution[]

  @@index([ownerId, status])
  @@index([isTemplate])
  @@map("automation_workflows")
}

model WorkflowTrigger {
  id          String             @id @default(cuid())
  workflowId  String
  workflow    AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  triggerType TriggerType
  config      Json?
  isActive    Boolean            @default(true)
  lastFired   DateTime?
  fireCount   Int                @default(0)
  createdAt   DateTime           @default(now())

  @@index([workflowId])
  @@index([triggerType, isActive])
  @@map("workflow_triggers")
}

model WorkflowExecution {
  id           String             @id @default(cuid())
  workflowId   String
  workflow     AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  ownerId      String
  triggerType  TriggerType?
  triggerData  Json?
  status       ExecutionStatus    @default(QUEUED_EXEC)
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int                @default(0)
  actionsRun   Int                @default(0)
  actionsTotal Int                @default(0)
  errorMessage String?
  retryCount   Int                @default(0)
  maxRetries   Int                @default(3)
  result       Json?
  createdAt    DateTime           @default(now())

  @@index([workflowId, createdAt])
  @@index([ownerId, status])
  @@map("workflow_executions")
}

model WorkflowTemplate {
  id            String   @id @default(cuid())
  creatorId     String
  name          String
  description   String?
  category      String   @default("general")
  triggerConfig Json
  conditions    Json?
  actions       Json
  tags          String[] @default([])
  installCount  Int      @default(0)
  rating        Float    @default(0)
  isPublic      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublic, category])
