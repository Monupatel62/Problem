// ─── Marketplace Category ───────────────────────────────────────────────────────
model WPMarketplaceCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  name        String
  slug        String   @unique
  description String?
  icon        String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now())

  listings    WPMarketplaceListing[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@map("wp_marketplace_categories")
}

// ─── Seller Profile ─────────────────────────────────────────────────────────────
model WPSellerProfile {
  id                String             @id @default(dbgenerated("gen_random_uuid()::text"))
  userId            String             @unique
  storeName         String
  storeSlug         String             @unique
  description       String?
  logo              String?
  banner            String?
  contactEmail      String?
  contactPhone      String?
  address           Json?              @default("{}")
  verification      WPSellerVerification @default(UNVERIFIED)
  rating            Float              @default(0)
  totalSales        Int                @default(0)
  totalRevenue      Float              @default(0)
  policies          Json?              @default("{}")
  socialLinks       Json?              @default("{}")
  metadata          Json?              @default("{}")
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation("UserSellerProfile", fields: [userId], references: [id], onDelete: Cascade)
  listings          WPMarketplaceListing[]

  @@index([userId])
  @@index([verification])
  @@index([rating(sort: Desc)])
  @@map("wp_seller_profiles")
}

// ─── Marketplace Listing ────────────────────────────────────────────────────────
model WPMarketplaceListing {
  id              String           @id @default(dbgenerated("gen_random_uuid()::text"))
  userId          String
  sellerId        String
  categoryId      String?
  title           String
  slug            String           @unique
  description     String?
  type            WPListingType    @default(USED_PRODUCT)
  condition       WPListingCondition?
  status          WPListingStatus  @default(DRAFT)
  price           Float            @default(0)
  originalPrice   Float?
  currency        String           @default("INR")
  negotiable      Boolean          @default(false)
  quantity        Int              @default(1)
  images          String[]         @default([])
  videos          String[]         @default([])
  tags            String[]         @default([])
  attributes      Json?            @default("{}")
  specifications  Json?            @default("{}")
  location        Json?            @default("{}")
  city            String?
  state           String?
  country         String?          @default("India")
  pincode         String?
  shippingOptions Json?            @default("[]")
  deliveryEstimate String?
  returnPolicy    String?
  warrantyInfo    String?
  viewCount       Int              @default(0)
  saveCount       Int              @default(0)
  inquiryCount    Int              @default(0)
  metadata        Json?            @default("{}")
  isFeatured      Boolean          @default(false)
  featuredUntil   DateTime?
  expiresAt       DateTime?
  soldAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User                 @relation("UserMarketplaceListings", fields: [userId], references: [id], onDelete: Cascade)
  seller          WPSellerProfile      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category        WPMarketplaceCategory? @relation(fields: [categoryId], references: [id])
  orders          WPMarketplaceOrder[]
  reviews         WPMarketplaceReview[]
  savedBy         WPSavedListing[]
  messages        WPMarketplaceMessage[]
  analytics       WPMarketplaceAnalytics[]

  @@index([userId])
  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@index([price])
  @@index([createdAt(sort: Desc)])
  @@map("wp_marketplace_listings")
}

// ─── Marketplace Order ──────────────────────────────────────────────────────────
model WPMarketplaceOrder {
  id             String         @id @default(dbgenerated("gen_random_uuid()::text"))
  orderNumber    String         @unique
  listingId      String
  buyerId        String
  sellerId       String
  quantity       Int            @default(1)
  unitPrice      Float
  totalPrice     Float
  currency       String         @default("INR")
  status         WPOrderStatus  @default(PENDING)
  shippingAddress Json?         @default("{}")
  shippingMethod String?
  trackingNumber String?
  notes          String?
  metadata       Json?          @default("{}")
  paidAt         DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  listing        WPMarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer          User                @relation("UserMarketplaceOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  transactions   WPMarketplaceTransaction[]

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("wp_marketplace_orders")
}

// ─── Marketplace Transaction ────────────────────────────────────────────────────
model WPMarketplaceTransaction {
  id            String          @id @default(dbgenerated("gen_random_uuid()::text"))
  orderId       String
  amount        Float
  currency      String          @default("INR")
  method        WPPaymentMethod @default(UPI)
  status        WPPaymentStatus @default(PENDING)
  transactionRef String?
  gatewayResponse Json?         @default("{}")
  metadata      Json?           @default("{}")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  order         WPMarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("wp_marketplace_transactions")
}

// ─── Marketplace Review ─────────────────────────────────────────────────────────
model WPMarketplaceReview {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  listingId  String
  userId     String
  rating     Int
  title      String?
  content    String?
  images     String[] @default([])
  isVerified Boolean  @default(false)
  helpfulCount Int    @default(0)
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listing    WPMarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user       User                @relation("UserMarketplaceReviews", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([listingId])
  @@index([userId])
  @@index([rating])
  @@map("wp_marketplace_reviews")
}

// ─── Saved Listing ──────────────────────────────────────────────────────────────
model WPSavedListing {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  userId     String
  listingId  String
  collection String?
  notes      String?
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now())

  user       User                 @relation("UserSavedListings", fields: [userId], references: [id], onDelete: Cascade)
  listing    WPMarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@index([collection])
  @@map("wp_saved_listings")
}

// ─── Marketplace Message ────────────────────────────────────────────────────────
model WPMarketplaceMessage {
  id              String   @id @default(dbgenerated("gen_random_uuid()::text"))
  listingId       String
  senderId        String
  receiverId      String
  conversationId  String
  content         String
  messageType     String   @default("text")
  attachments     Json?    @default("[]")
  isRead          Boolean  @default(false)
  readAt          DateTime?
  isDeleted       Boolean  @default(false)
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listing         WPMarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sender          User                @relation("UserMarketplaceMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([senderId])
  @@index([receiverId])
  @@index([conversationId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("wp_marketplace_messages")
}

// ─── Marketplace Analytics ──────────────────────────────────────────────────────
model WPMarketplaceAnalytics {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  listingId   String?
  sellerId    String?
  userId      String?
  eventType   String
  source      String?
  referrer    String?
  deviceType  String?
  location    Json?
  sessionId   String?
  duration    Int?
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now())

  listing     WPMarketplaceListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([sellerId])
  @@index([userId])
  @@index([eventType])
  @@index([createdAt(sort: Desc)])
  @@map("wp_marketplace_analytics")
}

// ─── Marketplace Audit Log ──────────────────────────────────────────────────────
model WPMarketplaceAuditLog {
  id         String                    @id @default(dbgenerated("gen_random_uuid()::text"))
  userId     String
  action     WPMarketplaceAuditAction
  targetId   String?
  targetType String?
  details    Json?                     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime                  @default(now())

  user       User                      @relation("UserMarketplaceAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([targetId])
  @@index([createdAt(sort: Desc)])
  @@map("wp_marketplace_audit_logs")
}

