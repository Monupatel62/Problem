// ─── Video ──────────────────────────────────────────────────────────────────────
model WPVideo {
  id              String        @id @default(dbgenerated("gen_random_uuid()::text"))
  title           String
  description     String?
  url             String?
  thumbnailUrl    String?
  duration        Int           @default(0)
  format          WPVideoFormat @default(MP4)
  qualities       Json?         @default("[]")
  fileSize        BigInt        @default(0)
  tags            String[]      @default([])
  category        String?
  channelId       String
  userId          String
  status          WPVideoStatus @default(DRAFT)
  viewCount       Int           @default(0)
  likeCount       Int           @default(0)
  dislikeCount    Int           @default(0)
  commentCount    Int           @default(0)
  shareCount      Int           @default(0)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  metadata        Json?         @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  channel         WPVideoChannel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user            User                    @relation("UserVideos", fields: [userId], references: [id], onDelete: Cascade)
  playlistVideos  WPPlaylistVideo[]
  watchHistory    WPWatchHistory[]
  analytics       WPVideoAnalytics[]
  subtitles       WPVideoSubtitle[]
  recommendations WPVideoRecommendation[] @relation("VideoRecommendations")
  recommendedIn   WPVideoRecommendation[] @relation("RecommendedVideos")
  reports         WPVideoReport[]

  @@index([channelId])
  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([viewCount(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("wp_videos")
}

// ─── Video Playlist ─────────────────────────────────────────────────────────────
model WPVideoPlaylist {
