model WPParticipant {
  id             String            @id @default(cuid())
  conversationId String
  conversation   WPConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  role           WPParticipantRole @default(MEMBER_CHAT)
  nickname       String?
