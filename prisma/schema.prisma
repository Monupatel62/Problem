// ─── Story ──────────────────────────────────────────────────────────────────────
model WPStory {
  id              String             @id @default(dbgenerated("gen_random_uuid()::text"))
  userId          String
  type            WPStoryType        @default(PHOTO)
  status          WPStoryStatus      @default(ACTIVE)
  visibility      WPStoryVisibility  @default(PUBLIC)
  caption         String?
  location        Json?              @default("{}")
  hashtags        String[]           @default([])
  mentions        String[]           @default([])
  musicId         String?
  duration        Int                @default(5)
  expiresAt       DateTime           @default(dbgenerated("(NOW() + INTERVAL '24 hours')"))
  isSponsored     Boolean            @default(false)
  ctaUrl          String?
  ctaText         String?
  viewCount       Int                @default(0)
  reactionCount   Int                @default(0)
  replyCount      Int                @default(0)
  shareCount      Int                @default(0)
  completionRate  Float              @default(0.0)
  hiddenFromUsers String[]           @default([])
  closeFriends    String[]           @default([])
  scheduledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt

  user       User               @relation("UserStories", fields: [userId], references: [id], onDelete: Cascade)
  media      WPStoryMedia[]     @relation("StoryMedia")
  viewers    WPStoryViewer[]    @relation("StoryViewers")
  reactions  WPStoryReaction[]  @relation("StoryReactions")
  replies    WPStoryReply[]     @relation("StoryReplies")
  stickers   WPStorySticker[]   @relation("StoryStickers")
  analytics  WPStoryAnalytics[] @relation("StoryAnalytics")
  archive    WPStoryArchive?    @relation("StoryArchive")
  reports    WPStoryReport[]    @relation("StoryReports")

  @@index([userId])
  @@index([status])
  @@index([visibility])
  @@index([type])
  @@index([expiresAt])
  @@index([createdAt(sort: Desc)])
  @@index([userId, status])
  @@map("wp_stories")
}

// ─── Story Media ────────────────────────────────────────────────────────────────
model WPStoryMedia {
  id           String   @id @default(dbgenerated("gen_random_uuid()::text"))
  storyId      String
  mediaUrl     String
  thumbnailUrl String?
  mediaType    String   @default("PHOTO")
  duration     Int?     @default(5)
  order        Int      @default(0)
  filters      Json?    @default("{}")
  overlays     Json?    @default("[]")
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  story WPStory @relation("StoryMedia", fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@index([storyId, order])
  @@map("wp_story_media")
}

// ─── Story Viewer ───────────────────────────────────────────────────────────────
model WPStoryViewer {
  id            String    @id @default(dbgenerated("gen_random_uuid()::text"))
  storyId       String
  userId        String
  viewedAt      DateTime  @default(now())
