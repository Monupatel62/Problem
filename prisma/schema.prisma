model CopyrightAsset {
  id             String    @id @default(cuid())
  ownerId        String
  assetType      AssetType
  title          String
  description    String?
  contentId      String?
  contentUrl     String?
  thumbnailUrl   String?
  metadata       Json?
  registrationId String?   @unique
  isVerified     Boolean   @default(false)
  verifiedAt     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ownership    OwnershipRecord[]
  fingerprints ContentFingerprint[]
  claims       RightsClaim[]
  audioRights  AudioRight[]

  @@index([ownerId, assetType])
  @@index([contentId])
  @@index([isActive, assetType])
  @@map("copyright_assets")
}

model OwnershipRecord {
  id            String         @id @default(cuid())
  assetId       String
  asset         CopyrightAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ownerId       String
  ownershipType String         @default("original")
  proofUrl      String?
  proofType     String?
  isPrimary     Boolean        @default(true)
  grantedAt     DateTime       @default(now())
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime       @default(now())

  @@index([assetId])
  @@index([ownerId])
  @@map("ownership_records")
}

model ContentFingerprint {
  id              String          @id @default(cuid())
  assetId         String
  asset           CopyrightAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fingerprintType FingerprintType
  hashValue       String
  algorithm       String          @default("perceptual_hash_v1")
  confidence      Float           @default(1.0)
  metadata        Json?
  createdAt       DateTime        @default(now())

  @@index([hashValue])
  @@index([assetId])
  @@map("content_fingerprints")
}

model RightsClaim {
  id                  String          @id @default(cuid())
  claimantId          String
  assetId             String?
  asset               CopyrightAsset? @relation(fields: [assetId], references: [id])
  infringingContentId String?
  infringingUserId    String?
  claimType           String
  detectionType       DetectionType?
  status              ClaimStatus     @default(SUBMITTED)
  description         String?
  evidence            Json?
  matchScore          Float?
  reviewerId          String?
  reviewedAt          DateTime?
  resolutionNotes     String?
  autoDetected        Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  disputes     RightsDispute[]
  enforcements EnforcementAction[]

  @@index([claimantId, status])
  @@index([status])
  @@index([infringingUserId])
  @@map("rights_claims")
}

model RightsDispute {
  id            String        @id @default(cuid())
  claimId       String
  claim         RightsClaim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  respondentId  String
  disputeReason String
  evidence      Json?
  status        DisputeStatus @default(OPEN_DISPUTE)
  counterClaim  String?
  reviewerId    String?
  reviewedAt    DateTime?
  resolution    String?
  appealCount   Int           @default(0)
  maxAppeals    Int           @default(2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([claimId])
  @@index([respondentId, status])
  @@map("rights_disputes")
}

model EnforcementAction {
  id              String          @id @default(cuid())
  claimId         String?
  claim           RightsClaim?    @relation(fields: [claimId], references: [id])
  targetUserId    String
  targetContentId String?
  actionType      EnforcementType
  reason          String?
  isAutomated     Boolean         @default(false)
  enforcedBy      String?
  enforcedAt      DateTime        @default(now())
  expiresAt       DateTime?
  isReversed      Boolean         @default(false)
  reversedAt      DateTime?
  reversedReason  String?
  metadata        Json?
  createdAt       DateTime        @default(now())

  @@index([targetUserId])
  @@index([claimId])
  @@map("enforcement_actions")
}

model BrandAsset {
  id          String         @id @default(cuid())
  ownerId     String
  assetType   BrandAssetType
  name        String
  description String?
  fileUrl     String?
  trademarkId String?
  isVerified  Boolean        @default(false)
  verifiedAt  DateTime?
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([ownerId])
  @@index([assetType])
  @@map("brand_assets")
}

model AudioRight {
  id             String          @id @default(cuid())
  ownerId        String
  assetId        String?
  asset          CopyrightAsset? @relation(fields: [assetId], references: [id])
  title          String
  artist         String?
  album          String?
  duration       Int             @default(0)
  licenseType    String          @default("original")
  isLicensed     Boolean         @default(false)
  licenseDetails Json?
  usageCount     Int             @default(0)
  fingerprint    String?
  createdAt      DateTime        @default(now())

  @@index([ownerId])
  @@index([fingerprint])
  @@map("audio_rights")
}

