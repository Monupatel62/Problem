  APPROVED
  SUSPENDED
  REJECTED
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

enum MembershipTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PayoutMethod {
  BANK_TRANSFER
  UPI
  PAYPAL
}

enum OrderStatus {
  PENDING_ORDER
  COMPLETED_ORDER
  REFUNDED
  DISPUTED
  CANCELLED_ORDER
}

enum ProductType {
  COURSE
  PDF
  TEMPLATE
  EBOOK
  RESOURCE
  OTHER
}

enum GiftType {
  HEART
  STAR
  DIAMOND
  CROWN
  ROCKET
  FIRE
  RAINBOW
  CUSTOM
}

enum CreatorTransactionType {
  SUBSCRIPTION
  MEMBERSHIP
  TIP
  GIFT
  PRODUCT_PURCHASE
  PAID_CONTENT
  LIVE_REVENUE
  PAYOUT
  REFUND
}

model CreatorMonetization {
  id                  String             @id @default(cuid())
  creatorId           String             @unique
  status              MonetizationStatus @default(UNDER_REVIEW)
  isVerified          Boolean            @default(false)
  minFollowersReached Boolean            @default(false)
  minWatchTimeReached Boolean            @default(false)
  contentQualityScore Float              @default(0)
  guidelineCompliance Boolean            @default(true)
  applicationDate     DateTime?
  approvedAt          DateTime?
  suspendedAt         DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  totalEarnings       Float              @default(0)
  currentBalance      Float              @default(0)
  pendingBalance      Float              @default(0)
  withdrawableBalance Float              @default(0)
  currency            String             @default("INR")
  taxId               String?
  businessName        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status])
  @@map("creator_monetization")
}

model CreatorSubscription {
  id           String               @id @default(cuid())
  creatorId    String
  subscriberId String
  interval     SubscriptionInterval @default(MONTHLY)
  price        Float
  currency     String               @default("INR")
  isActive     Boolean              @default(true)
  benefits     Json?
  startDate    DateTime             @default(now())
  endDate      DateTime
  renewedAt    DateTime?
  cancelledAt  DateTime?
  autoRenew    Boolean              @default(true)
  paymentId    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([creatorId, subscriberId])
  @@index([creatorId, isActive])
  @@index([subscriberId])
  @@index([endDate])
  @@map("creator_subscriptions")
}

model CreatorMembership {
  id            String         @id @default(cuid())
  creatorId     String
  userId        String
  tier          MembershipTier @default(BRONZE)
  price         Float
  currency      String         @default("INR")
  isActive      Boolean        @default(true)
  benefits      Json?
  loyaltyPoints Int            @default(0)
  startDate     DateTime       @default(now())
  endDate       DateTime?
  renewedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([creatorId, userId])
  @@index([creatorId, tier, isActive])
  @@index([userId])
  @@map("creator_memberships")
}

model CreatorTip {
  id          String   @id @default(cuid())
  creatorId   String
  tipperId    String
  amount      Float
  currency    String   @default("INR")
  message     String?
  isAnonymous Boolean  @default(false)
  paymentId   String?
  contentId   String?
  contentType String?
  createdAt   DateTime @default(now())

  @@index([creatorId, createdAt])
  @@index([tipperId])
  @@map("creator_tips")
}

model CreatorGift {
  id           String   @id @default(cuid())
  creatorId    String
  senderId     String
  giftType     GiftType
  giftName     String
  value        Float
  currency     String   @default("INR")
  message      String?
  animationUrl String?
  contentId    String?
  contentType  String?
  isLiveGift   Boolean  @default(false)
  paymentId    String?
  createdAt    DateTime @default(now())

  @@index([creatorId, createdAt])
  @@index([senderId])
  @@index([creatorId, giftType])
  @@map("creator_gifts")
}

model CreatorWallet {
  id                  String    @id @default(cuid())
  creatorId           String    @unique
  balance             Float     @default(0)
  pendingBalance      Float     @default(0)
  withdrawableBalance Float     @default(0)
  totalEarned         Float     @default(0)
  totalWithdrawn      Float     @default(0)
  totalRefunded       Float     @default(0)
  currency            String    @default("INR")
  lastTransactionAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  transactions CreatorTransaction[]
  payouts      CreatorPayout[]

  @@map("creator_wallets")
}

model CreatorTransaction {
  id          String                 @id @default(cuid())
  walletId    String
  wallet      CreatorWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  creatorId   String
  type        CreatorTransactionType
  amount      Float
  fee         Float                  @default(0)
  net         Float
  currency    String                 @default("INR")
  description String?
  metadata    Json?
  referenceId String?
  fromUserId  String?
  status      String                 @default("completed")
  createdAt   DateTime               @default(now())

  @@index([walletId, createdAt])
  @@index([creatorId, type, createdAt])
  @@index([creatorId, createdAt])
  @@map("creator_transactions")
}

model CreatorPayout {
  id             String        @id @default(cuid())
  creatorId      String
  walletId       String
  wallet         CreatorWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount         Float
  fee            Float         @default(0)
  net            Float
  currency       String        @default("INR")
  method         PayoutMethod
  status         PayoutStatus  @default(PENDING)
  bankDetails    Json?
  requestedAt    DateTime      @default(now())
  processedAt    DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  transactionRef String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([creatorId, status])
  @@index([creatorId, createdAt])
  @@index([status, requestedAt])
  @@map("creator_payouts")
}

model DigitalProduct {
  id           String      @id @default(cuid())
  creatorId    String
  title        String
  description  String?
  productType  ProductType
  price        Float
  currency     String      @default("INR")
  fileUrl      String?
  thumbnailUrl String?
  previewUrl   String?
  metadata     Json?
  isPublished  Boolean     @default(true)
  salesCount   Int         @default(0)
  totalRevenue Float       @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orders ProductOrder[]

  @@index([creatorId, isPublished])
  @@index([creatorId, productType])
  @@map("digital_products")
}

model ProductOrder {
  id            String         @id @default(cuid())
  productId     String
  product       DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId       String
  creatorId     String
  amount        Float
  currency      String         @default("INR")
  status        OrderStatus    @default(PENDING_ORDER)
  paymentId     String?
  downloadUrl   String?
  downloadCount Int            @default(0)
  maxDownloads  Int            @default(5)
  refundedAt    DateTime?
  refundReason  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([buyerId, createdAt])
  @@index([creatorId, createdAt])
  @@index([productId, status])
  @@map("product_orders")
}

// ── Phase 12: Creator Marketplace & Digital Commerce ──────────────────────

enum ServiceType {
  CONSULTING
  COACHING
  DEVELOPMENT
  DESIGN
  MARKETING
  EDUCATION
  MENTORING
  OTHER_SERVICE
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  PENDING_VERIFICATION
}

enum ListingStatus {
  DRAFT_LISTING
  ACTIVE_LISTING
  PAUSED
  ARCHIVED_LISTING
  REMOVED
}

enum MarketplaceOrderStatus {
  PENDING_MKT
  PAID_MKT
  PROCESSING_MKT
  DELIVERED
  COMPLETED_MKT
  REFUNDED_MKT
  CANCELLED_MKT
  DISPUTED_MKT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model CreatorStore {
  id            String      @id @default(cuid())
  creatorId     String      @unique
  storeName     String
  storeSlug     String      @unique
  description   String?
  logoUrl       String?
  bannerUrl     String?
  themeColor    String      @default("#7c3aed")
  categories    String[]    @default([])
  contactEmail  String?
  website       String?
  socialLinks   Json?
  status        StoreStatus @default(ACTIVE)
  isVerified    Boolean     @default(false)
  verifiedAt    DateTime?
  totalProducts Int         @default(0)
  totalServices Int         @default(0)
  totalSales    Int         @default(0)
  totalRevenue  Float       @default(0)
  rating        Float       @default(0)
  reviewCount   Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  services  ServiceListing[]
  courses   CourseListing[]
  orders    MarketplaceOrder[]
  coupons   MarketplaceCoupon[]
  reviews   MarketplaceReview[]
  analytics MarketplaceAnalytics[]

  @@index([status])
  @@index([rating])
  @@map("creator_stores")
}

model ServiceListing {
  id            String        @id @default(cuid())
  storeId       String
  store         CreatorStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  creatorId     String
  title         String
  description   String?
  serviceType   ServiceType
  status        ListingStatus @default(ACTIVE_LISTING)
  basePrice     Float
  currency      String        @default("INR")
  deliveryDays  Int           @default(7)
  revisionCount Int           @default(1)
  packages      Json?
  requirements  String?
  tags          String[]      @default([])
  thumbnailUrl  String?
  gallery       Json?
  totalOrders   Int           @default(0)
  totalRevenue  Float         @default(0)
  rating        Float         @default(0)
  reviewCount   Int           @default(0)
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([storeId, status])
  @@index([serviceType, status])
  @@index([rating])
  @@map("service_listings")
}

model CourseListing {
  id            String        @id @default(cuid())
  storeId       String
  store         CreatorStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  creatorId     String
  title         String
  description   String?
  category      String?
  status        ListingStatus @default(ACTIVE_LISTING)
  price         Float
  currency      String        @default("INR")
  thumbnailUrl  String?
  previewUrl    String?
  totalLessons  Int           @default(0)
  totalModules  Int           @default(0)
  totalDuration Int           @default(0)
  level         String        @default("beginner")
  tags          String[]      @default([])
  requirements  String[]      @default([])
  outcomes      String[]      @default([])
  totalStudents Int           @default(0)
  totalRevenue  Float         @default(0)
  rating        Float         @default(0)
  reviewCount   Int           @default(0)
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  modules MktCourseModule[]

  @@index([storeId, status])
  @@index([category, status])
  @@index([rating])
  @@map("course_listings")
}

model MktCourseModule {
  id          String        @id @default(cuid())
  courseId    String
  course      CourseListing @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())

  lessons MktCourseLesson[]

  @@index([courseId])
  @@map("mkt_course_modules")
}

model MktCourseLesson {
  id          String          @id @default(cuid())
  moduleId    String
  module      MktCourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId    String
  title       String
  contentType String          @default("video")
  contentUrl  String?
  duration    Int             @default(0)
  sortOrder   Int             @default(0)
  isPreview   Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([moduleId])
  @@map("mkt_course_lessons")
}

model MktCourseProgress {
  id          String    @id @default(cuid())
  courseId    String
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([courseId, userId, lessonId])
  @@index([courseId, userId])
  @@map("mkt_course_progress")
}

model MarketplaceOrder {
  id            String                 @id @default(cuid())
  orderNumber   String                 @unique
  storeId       String
  store         CreatorStore           @relation(fields: [storeId], references: [id])
  buyerId       String
  sellerId      String
  itemType      String
  itemId        String
  itemTitle     String
  quantity      Int                    @default(1)
  unitPrice     Float
  subtotal      Float
  discount      Float                  @default(0)
  platformFee   Float                  @default(0)
  total         Float
  currency      String                 @default("INR")
  status        MarketplaceOrderStatus @default(PENDING_MKT)
  paymentMethod String?
  paymentId     String?
  couponId      String?
  downloadUrl   String?
  downloadCount Int                    @default(0)
  maxDownloads  Int                    @default(10)
  deliveryDate  DateTime?
  completedAt   DateTime?
  refundedAt    DateTime?
  refundReason  String?
  notes         String?
  metadata      Json?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  invoice MarketplaceInvoice?
  reviews MarketplaceReview[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([storeId, createdAt])
  @@map("marketplace_orders")
}

model MarketplaceInvoice {
  id            String           @id @default(cuid())
  invoiceNumber String           @unique
  orderId       String           @unique
  order         MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId       String
  sellerId      String
  subtotal      Float
  discount      Float            @default(0)
  tax           Float            @default(0)
  total         Float
  currency      String           @default("INR")
  status        String           @default("issued")
  paidAt        DateTime?
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime         @default(now())

  @@index([buyerId])
  @@index([sellerId])
  @@map("marketplace_invoices")
}

model MarketplaceCoupon {
  id            String       @id @default(cuid())
  storeId       String
  store         CreatorStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  creatorId     String
  code          String
  discountType  DiscountType
  discountValue Float
  minOrder      Float        @default(0)
  maxDiscount   Float?
  usageLimit    Int?
  usageCount    Int          @default(0)
  perUserLimit  Int          @default(1)
  applicableTo  String       @default("all")
  productIds    String[]     @default([])
  startsAt      DateTime     @default(now())
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@unique([storeId, code])
  @@index([isActive, expiresAt])
  @@map("marketplace_coupons")
}

model MarketplaceReview {
  id           String            @id @default(cuid())
  storeId      String?
  store        CreatorStore?     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  itemType     String
  itemId       String
  orderId      String?
  order        MarketplaceOrder? @relation(fields: [orderId], references: [id])
