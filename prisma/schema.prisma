  user         User              @relation("UserAdCampaigns", fields: [userId], references: [id], onDelete: Cascade)
  adSets       WPAdSet[]
  adConversions WPAdConversion[]
  analytics    WPAdAnalytics[]
  fraudLogs    WPAdFraudLog[]

  @@index([accountId])
  @@index([userId])
  @@index([status])
  @@index([objective])
  @@index([createdAt(sort: Desc)])
  @@map("wp_ad_campaigns")
}

