  @@index([reelId])
  @@index([reporterId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("wp_reel_reports")
}

// ─── Reel Audit Log ─────────────────────────────────────────────────────────────
model WPReelAuditLog {
  id         String            @id @default(dbgenerated("gen_random_uuid()::text"))
  userId     String
  action     WPReelAuditAction
  targetId   String?
  targetType String?
  details    Json?             @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime          @default(now())

  user User @relation("UserReelAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([targetId])
  @@index([createdAt(sort: Desc)])
  @@map("wp_reel_audit_logs")
}

