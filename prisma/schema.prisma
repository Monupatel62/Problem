// ── Phase 9: Advanced Analytics Engine ──────────────────────────────────────────

enum AnalyticsEventType {
  PAGE_VIEW
  CONTENT_VIEW
  ENGAGEMENT
  FOLLOW
  SUBSCRIBE
  SHARE
  SAVE
  SEARCH
  CLICK
  CONVERSION
}

enum AnalyticsPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AlertType {
  VIRAL_CONTENT
  ENGAGEMENT_DROP
  REACH_SPIKE
  AUDIENCE_CHURN
  MILESTONE
  GROWTH_SPIKE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ReportFormat {
  PDF
  CSV
  EXCEL
  JSON
}

enum ReportSchedule {
