  IMAGE_MEDIA
  VIDEO_MEDIA
  GIF_MEDIA
}

enum WPShareType {
  SHARE_WP
  REPOST_WP
  QUOTE_WP
}

model WPPost {
  id             String       @id @default(cuid())
  authorId       String
  postType       WPPostType   @default(TEXT_WP)
  content        String?
  mediaUrls      String[]     @default([])
  linkUrl        String?
  linkPreview    Json?
  pollData       Json?
  hashtags       String[]     @default([])
  mentions       String[]     @default([])
  visibility     WPVisibility @default(PUBLIC_VIS)
  status         WPPostStatus @default(PUBLISHED_WP)
  scheduledAt    DateTime?
  publishedAt    DateTime?    @default(now())
  editedAt       DateTime?
  originalPostId String?
  shareType      WPShareType?
  quoteText      String?
  likeCount      Int          @default(0)
  commentCount   Int          @default(0)
  shareCount     Int          @default(0)
  viewCount      Int          @default(0)
  saveCount      Int          @default(0)
  isPinned       Boolean      @default(false)
