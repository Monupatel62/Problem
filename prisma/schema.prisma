model WPGroup {
  id              String        @id @default(dbgenerated("gen_random_uuid()::text"))
  name            String
  slug            String        @unique
  description     String?
  type            WPGroupType   @default(PUBLIC)
  status          WPGroupStatus @default(ACTIVE)
  ownerId         String
  coverImage      String?
  avatarImage     String?
  category        String?
  tags            String[]      @default([])
  rules           Json?         @default("[]")
  settings        Json?         @default("{}")
  memberCount     Int           @default(0)
  postCount       Int           @default(0)
  isVerified      Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  requireApproval Boolean       @default(false)
  allowInvites    Boolean       @default(true)
  location        String?
  website         String?
  metadata        Json?         @default("{}")
  lastActivityAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner         User                  @relation("UserOwnedGroups", fields: [ownerId], references: [id], onDelete: Cascade)
  members       WPGroupMember[]
  posts         WPGroupPost[]
  groupRules    WPGroupRule[]
  announcements WPGroupAnnouncement[]
  analytics     WPGroupAnalytics[]
  badges        WPCommunityBadge[]
  events        WPGroupEvent[]
  channels      WPGroupChannel[]
  auditLogs     WPGroupAuditLog[]

  @@index([ownerId])
  @@index([type])
  @@index([status])
  @@index([category])
  @@index([isFeatured])
  @@index([memberCount(sort: Desc)])
  @@index([lastActivityAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("wp_groups")
}

model WPGroupMember {
  id           String              @id @default(dbgenerated("gen_random_uuid()::text"))
  groupId      String
  userId       String
  role         WPGroupMemberRole   @default(MEMBER)
  status       WPGroupMemberStatus @default(ACTIVE)
  nickname     String?
  invitedBy    String?
  approvedBy   String?
  mutedUntil   DateTime?
  bannedReason String?
  contribution Int                 @default(0)
  lastSeenAt   DateTime?
  joinedAt     DateTime            @default(now())
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  group WPGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User    @relation("UserGroupMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@index([joinedAt(sort: Desc)])
  @@map("wp_group_members")
}

model WPGroupPost {
  id             String            @id @default(dbgenerated("gen_random_uuid()::text"))
  groupId        String
  authorId       String
  type           WPGroupPostType   @default(TEXT)
  status         WPGroupPostStatus @default(PUBLISHED)
  content        String?
  mediaUrls      String[]          @default([])
  linkPreview    Json?
  pollData       Json?
  isPinned       Boolean           @default(false)
  isFeatured     Boolean           @default(false)
  isAnonymous    Boolean           @default(false)
  likeCount      Int               @default(0)
  commentCount   Int               @default(0)
  shareCount     Int               @default(0)
  viewCount      Int               @default(0)
  metadata       Json?             @default("{}")
  approvedBy     String?
  rejectedReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  group  WPGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User    @relation("UserGroupPosts", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([authorId])
  @@index([type])
  @@index([status])
  @@index([isPinned])
  @@index([createdAt(sort: Desc)])
  @@map("wp_group_posts")
}

model WPGroupRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  groupId     String
  title       String
  description String?
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group   WPGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User    @relation("UserGroupRules", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([orderIndex])
  @@map("wp_group_rules")
}

model WPGroupAnnouncement {
  id        String    @id @default(dbgenerated("gen_random_uuid()::text"))
  groupId   String
  authorId  String
  title     String
  content   String
  isPinned  Boolean   @default(false)
  priority  Int       @default(0)
  expiresAt DateTime?
  viewCount Int       @default(0)
  metadata  Json?     @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  group  WPGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User    @relation("UserGroupAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([isPinned])
  @@index([createdAt(sort: Desc)])
  @@map("wp_group_announcements")
}

model WPGroupAnalytics {
  id              String   @id @default(dbgenerated("gen_random_uuid()::text"))
  groupId         String
  date            DateTime @db.Date
  newMembers      Int      @default(0)
  leftMembers     Int      @default(0)
  totalMembers    Int      @default(0)
  postsCreated    Int      @default(0)
  commentsCreated Int      @default(0)
  reactionsCount  Int      @default(0)
  activeMembers   Int      @default(0)
  pageViews       Int      @default(0)
  engagementRate  Float?   @default(0)
  topContributors Json?    @default("[]")
  popularPosts    Json?    @default("[]")
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now())

  group WPGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, date])
  @@index([groupId])
  @@index([date(sort: Desc)])
  @@map("wp_group_analytics")
}

model WPCommunityBadge {
  id          String      @id @default(dbgenerated("gen_random_uuid()::text"))
  groupId     String
  userId      String
  type        WPBadgeType
  name        String
  description String?
  icon        String?
  color       String?
  awardedBy   String?
  reason      String?
  metadata    Json?       @default("{}")
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())

  group WPGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User    @relation("UserGroupBadges", fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
  @@index([type])
  @@map("wp_community_badges")
}

model WPGroupEvent {
  id           String             @id @default(dbgenerated("gen_random_uuid()::text"))
  groupId      String
  creatorId    String
  title        String
  description  String?
  coverImage   String?
  status       WPGroupEventStatus @default(UPCOMING)
  location     String?
  isOnline     Boolean            @default(false)
  meetingUrl   String?
  startDate    DateTime
  endDate      DateTime?
  maxAttendees Int?
  rsvpCount    Int                @default(0)
  attendees    Json?              @default("[]")
  tags         String[]           @default([])
  metadata     Json?              @default("{}")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  group   WPGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
