model WPConversation {
  id                 String             @id @default(cuid())
  type               WPConversationType
  name               String?
  avatarUrl          String?
  description        String?
  createdBy          String
  lastMessageId      String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
