model WPPage {
  id                String           @id @default(dbgenerated("gen_random_uuid()::text"))
  userId            String
  name              String
  username          String           @unique
  type              WPPageType       @default(CREATOR)
  status            WPPageStatus     @default(ACTIVE)
  description       String?
  about             String?
  profilePicture    String?
  coverPhoto        String?
  website           String?
  email             String?
  phone             String?
  address           Json?
  category          String           @default("General")
  subcategory       String?
  socialLinks       Json?            @default("{}")
  contactDetails    Json?            @default("{}")
  businessHours     Json?
  location          Json?
  tags              String[]         @default([])
  followersCount    Int              @default(0)
  likesCount        Int              @default(0)
  postsCount        Int              @default(0)
  reviewsCount      Int              @default(0)
  averageRating     Float?           @default(0)
  isVerified        Boolean          @default(false)
  verificationBadge String?
  visibility        WPPageVisibility @default(PUBLIC)
  settings          Json?            @default("{}")
  metadata          Json?            @default("{}")
  isPinned          Boolean          @default(false)
  isFeatured        Boolean          @default(false)
  lastActiveAt      DateTime?
  archivedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles           WPPageRole[]
  followers       WPPageFollower[]
  content         WPPageContent[]
  verifications   WPPageVerification[]
  analytics       WPPageAnalytics[]
  reviews         WPPageReview[]
  messages        WPPageMessage[]
  pageSettings    WPPageSettings?
  moderationRules WPPageModerationRule[]
  auditLogs       WPPageAuditLog[]
  insights        WPPageInsight[]

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([category])
  @@index([visibility])
  @@index([isVerified])
  @@index([followersCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("wp_pages")
}

model WPPageRole {
  id          String         @id @default(dbgenerated("gen_random_uuid()::text"))
  pageId      String
  userId      String
  role        WPPageRoleType @default(EDITOR)
  permissions Json?          @default("{}")
  invitedBy   String?
  acceptedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  page WPPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId])
  @@index([userId])
  @@index([role])
  @@map("wp_page_roles")
}

model WPPageFollower {
  id            String   @id @default(dbgenerated("gen_random_uuid()::text"))
  pageId        String
  userId        String
  notifyOnPost  Boolean  @default(true)
  notifyOnLive  Boolean  @default(true)
  notifyOnEvent Boolean  @default(false)
  isMuted       Boolean  @default(false)
  source        String?  @default("organic")
  createdAt     DateTime @default(now())

  page WPPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("wp_page_followers")
}

model WPPageContent {
  id             String              @id @default(dbgenerated("gen_random_uuid()::text"))
  pageId         String
  authorId       String
  type           WPPageContentType   @default(POST)
  status         WPPageContentStatus @default(DRAFT)
  title          String?
  body           String?
  mediaUrls      String[]            @default([])
  thumbnailUrl   String?
  hashtags       String[]            @default([])
  mentions       String[]            @default([])
  likesCount     Int                 @default(0)
  commentsCount  Int                 @default(0)
  sharesCount    Int                 @default(0)
  viewsCount     Int                 @default(0)
  reachCount     Int                 @default(0)
  engagementRate Float?              @default(0)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  expiresAt      DateTime?
  isPinned       Boolean             @default(false)
  isSponsored    Boolean             @default(false)
  metadata       Json?               @default("{}")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  page   WPPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([authorId])
  @@index([type])
  @@index([status])
  @@index([publishedAt(sort: Desc)])
  @@index([scheduledAt])
  @@index([pageId, status])
  @@map("wp_page_content")
}

model WPPageVerification {
  id             String                   @id @default(dbgenerated("gen_random_uuid()::text"))
  pageId         String
  requestedBy    String
  type           WPPageVerificationType
  status         WPPageVerificationStatus @default(PENDING)
  documents      String[]                 @default([])
  businessName   String?
  businessRegNo  String?
  governmentId   String?
  additionalInfo Json?                    @default("{}")
  reviewedBy     String?
  reviewNotes    String?
  verifiedAt     DateTime?
  rejectedAt     DateTime?
  revokedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  page WPPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([status])
  @@index([type])
  @@map("wp_page_verifications")
}

model WPPageAnalytics {
  id                   String   @id @default(dbgenerated("gen_random_uuid()::text"))
  pageId               String
  date                 DateTime @db.Date
  followersGained      Int      @default(0)
  followersLost        Int      @default(0)
  netFollowers         Int      @default(0)
  totalFollowers       Int      @default(0)
  impressions          Int      @default(0)
  reach                Int      @default(0)
  profileViews         Int      @default(0)
  websiteClicks        Int      @default(0)
  postsPublished       Int      @default(0)
  totalLikes           Int      @default(0)
  totalComments        Int      @default(0)
  totalShares          Int      @default(0)
  engagementRate       Float?   @default(0)
  topContentId         String?
  audienceDemographics Json?    @default("{}")
  trafficSources       Json?    @default("{}")
  peakHours            Json?    @default("{}")
  metadata             Json?    @default("{}")
  createdAt            DateTime @default(now())

  page WPPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, date])
  @@index([pageId])
  @@index([date(sort: Desc)])
  @@map("wp_page_analytics")
}

model WPPageReview {
  id           String             @id @default(dbgenerated("gen_random_uuid()::text"))
  pageId       String
  userId       String
  rating       Int                @default(5)
  title        String?
  body         String?
  status       WPPageReviewStatus @default(ACTIVE)
  isVerified   Boolean            @default(false)
  helpfulCount Int                @default(0)
  reportCount  Int                @default(0)
  ownerReply   String?
  repliedAt    DateTime?
  moderatedBy  String?
  moderatedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  page WPPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId])
  @@index([userId])
  @@index([rating])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("wp_page_reviews")
}

model WPPageMessage {
  id          String              @id @default(dbgenerated("gen_random_uuid()::text"))
  pageId      String
  senderId    String
  subject     String?
  body        String
  status      WPPageMessageStatus @default(OPEN)
  isRead      Boolean             @default(false)
  isStarred   Boolean             @default(false)
  replyTo     String?
  respondedBy String?
  respondedAt DateTime?
  autoReply   Boolean             @default(false)
  attachments String[]            @default([])
  metadata    Json?               @default("{}")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  page   WPPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([senderId])
  @@index([status])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("wp_page_messages")
}

model WPPageSettings {
  id                   String   @id @default(dbgenerated("gen_random_uuid()::text"))
  pageId               String   @unique
  messagingEnabled     Boolean  @default(true)
  reviewsEnabled       Boolean  @default(true)
  autoReplyEnabled     Boolean  @default(false)
  autoReplyMessage     String?
  notifyNewFollower    Boolean  @default(true)
  notifyNewMessage     Boolean  @default(true)
  notifyNewReview      Boolean  @default(true)
  notifyMentions       Boolean  @default(true)
  contentModeration    Boolean  @default(true)
  profanityFilter      Boolean  @default(true)
  spamFilter           Boolean  @default(true)
  ageRestriction       Int?
  countryRestrictions  String[] @default([])
  allowedLanguages     String[] @default([])
  customWelcomeMessage String?
  appointmentUrl       String?
  ctaButton            Json?
  seoSettings          Json?    @default("{}")
  integrations         Json?    @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  page WPPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("wp_page_settings")
}

model WPPageModerationRule {
  id        String                 @id @default(dbgenerated("gen_random_uuid()::text"))
  pageId    String
  action    WPPageModerationAction
  keyword   String?
  userId    String?
  reason    String?
  isActive  Boolean                @default(true)
  createdBy String
  expiresAt DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  page WPPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([action])
  @@map("wp_page_moderation_rules")
}

model WPPageAuditLog {
  id        String            @id @default(dbgenerated("gen_random_uuid()::text"))
  pageId    String
  userId    String
  action    WPPageAuditAction
  targetId  String?
  details   Json?             @default("{}")
  ipAddress String?
  userAgent String?
  createdAt DateTime          @default(now())

  page WPPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("wp_page_audit_logs")
}

model WPPageInsight {
  id                   String   @id @default(dbgenerated("gen_random_uuid()::text"))
  pageId               String
  period               String   @default("weekly")
  startDate            DateTime @db.Date
  endDate              DateTime @db.Date
  totalReach           Int      @default(0)
  totalImpressions     Int      @default(0)
  totalEngagement      Int      @default(0)
  avgEngagementRate    Float?   @default(0)
  followerGrowthRate   Float?   @default(0)
  topPerformingContent Json?    @default("[]")
  audienceAge          Json?    @default("{}")
  audienceGender       Json?    @default("{}")
  audienceLocation     Json?    @default("{}")
  audienceActivity     Json?    @default("{}")
  contentBreakdown     Json?    @default("{}")
  growthTrend          Json?    @default("[]")
  recommendations      Json?    @default("[]")
  createdAt            DateTime @default(now())

  page WPPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, period, startDate])
  @@index([pageId])
  @@index([period])
  @@map("wp_page_insights")
}

